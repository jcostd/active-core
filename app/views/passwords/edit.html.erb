<div class="hero min-h-screen bg-base-100">
  <div class="hero-content flex-col lg:flex-row-reverse gap-12">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold">Nuova password</h1>
      <p class="py-6">Scegline una di almeno 4 caratteri e ripetila per conferma.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-md border p-4">
        <legend class="fieldset-legend">Reimposta password</legend>

        <%= form.label :password, "Nuova password", class: "label" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
                                           minlength: 4, maxlength: 72, class: "input w-full" %>

        <%= form.label :password_confirmation, "Ripeti la password", class: "label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                                                        minlength: 4, maxlength: 72, class: "input w-full" %>

        <%= form.submit "Salva", class: "btn btn-neutral mt-4" %>
        <%= link_to "Torna all'accesso", new_session_path, class: "link link-hover text-center mt-2" %>
      </fieldset>
    <% end %>
  </div>
</div>

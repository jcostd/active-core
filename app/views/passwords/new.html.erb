<div class="hero min-h-screen bg-base-100">
  <div class="hero-content flex-col lg:flex-row-reverse gap-12">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold">Password dimenticata?</h1>
      <p class="py-6">Ti mandiamo per email il link per sceglierne una nuova.</p>
    </div>

    <%= form_with url: passwords_path, class: "contents" do |form| %>
      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-md border p-4">
        <legend class="fieldset-legend">Recupero password</legend>

        <%= form.label :email_address, "Email", class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                                             value: params[:email_address], class: "input w-full" %>

        <%= form.submit "Inviami le istruzioni", class: "btn btn-neutral mt-4" %>
        <%= link_to "Torna all'accesso", new_session_path, class: "link link-hover text-center mt-2" %>
      </fieldset>
    <% end %>
  </div>
</div>

<%# locals: (sale:) %>
<li class="list-row items-center">
  <%= ui_avatar(sale.member, size: "size-10", text_size: "text-md") %>
  <div class="min-w-0">
    <%= link_to sale.member.full_name, sale.member, class: "font-semibold truncate hover:text-primary" %>
    <div class="text-[10px] text-base-content/60 uppercase tracking-wide truncate"><%= sale.product_name_snapshot %></div>
  </div>
  <div class="flex flex-col items-end gap-0.5">
    <span class="badge badge-success badge-sm badge-soft font-mono font-bold"><%= format_money(sale.amount) %></span>
    <span class="text-[10px] font-mono opacity-50"><%= l(sale.created_at, format: "%H:%M") %></span>
  </div>
</li>

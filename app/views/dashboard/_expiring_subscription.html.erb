<%# locals: (sub:) %>
<li class="list-row items-center">
  <div class="list-col-grow min-w-0">
    <%= link_to sub.member.full_name, sub.member, class: "font-semibold truncate link link-hover" %>
    <div class="text-xs font-mono opacity-60"><%= sub.product.name %> · scade il <%= l(sub.end_date, format: "%d/%m") %></div>
  </div>
  <%= link_to "Rinnova", renew_sale_path(sub), class: "btn btn-sm btn-outline", data: { turbo_frame: "modal" } %>
</li>

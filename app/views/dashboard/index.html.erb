<header class="flex flex-col sm:flex-row gap-4 justify-between sm:items-center mb-8">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-base-content">
      Buongiorno, <%= Current.session.user.first_name %> 👋
    </h1>
    <p class="text-sm text-base-content/60 mt-1">
      Situazione operativa della struttura.
    </p>
  </div>

  <%= link_to new_sale_path, class: "btn btn-primary shadow-sm" do %>
    <%= icon("add", size: 20) %> Nuova Vendita
  <% end %>
</header>

<%# RIGA 1: STATISTICHE (Il requisito Cash rimane prioritario) %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">

  <div class="stat bg-base-100 rounded-2xl shadow-sm">
    <div class="stat-figure text-success/50"><%= icon("payments", size: 28) %></div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Cash Mattina</div>
    <div class="stat-value text-xl md:text-2xl"><%= format_money(@daily_cash.morning_total) %></div>
  </div>

  <div class="stat bg-base-100 rounded-2xl shadow-sm">
    <div class="stat-figure text-success/50"><%= icon("payments", size: 28) %></div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Cash Pomeriggio</div>
    <div class="stat-value text-xl md:text-2xl"><%= format_money(@daily_cash.afternoon_total) %></div>
  </div>

  <div class="stat bg-base-100 rounded-2xl shadow-sm">
    <div class="stat-figure text-info/50"><%= icon("login", size: 28) %></div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Ingressi Oggi</div>
    <div class="stat-value text-xl md:text-2xl"><%= @today_accesses_count %></div>
  </div>

  <div class="stat bg-base-100 rounded-2xl shadow-sm">
    <div class="stat-figure <%= @expiring_count > 0 ? 'text-warning/50' : 'text-base-content/30' %>">
      <%= icon("notification_important", size: 28) %>
    </div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Scadenze (7gg)</div>
    <div class="stat-value text-xl md:text-2xl <%= 'text-warning' if @expiring_count > 0 %>"><%= @expiring_count %></div>
  </div>

</div>

<%# RIGA 2: I FEED OPERATIVI (Liste, non tabelle) %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <%# COLONNA 1: Timeline Ingressi %>
  <div class="lg:col-span-2 flex flex-col bg-base-100 rounded-2xl shadow-sm p-5 md:p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-base font-bold flex items-center gap-2">
        <%= icon("history", size: 18, class: "opacity-50") %> Registro Accessi
      </h2>
      <%= link_to "Vedi tutti", access_logs_path, class: "text-xs font-semibold link link-hover text-base-content/60" %>
    </div>

    <% if @recent_accesses.any? %>
      <ul class="flex-1 flex flex-col gap-1">
        <% @recent_accesses.each do |log| %>
          <li class="group flex items-center justify-between py-3 px-2 -mx-2 rounded-lg hover:bg-base-200/50 transition-colors">

            <div class="flex items-center gap-3">
              <%# Avatar testuale minimalista %>
              <div class="avatar placeholder hidden sm:flex">
                <div class="bg-base-200 text-base-content rounded-full w-10">
                  <span class="text-xs font-medium uppercase"><%= log.member.first_name[0] %><%= log.member.last_name[0] %></span>
                </div>
              </div>

              <div class="flex flex-col">
                <span class="text-sm font-semibold group-hover:text-primary transition-colors">
                  <%= link_to log.member.full_name, log.member %>
                </span>
                <span class="text-xs text-base-content/60">
                  <%= log.discipline&.name || 'Sala Pesi / Libero' %>
                </span>
              </div>
            </div>

            <div class="flex items-center gap-4 text-right">
              <% if log.status == 0 %>
                <div class="badge badge-success badge-sm badge-outline gap-1 hidden sm:inline-flex"><%= icon("check", size: 12) %> OK</div>
              <% else %>
                <div class="badge badge-warning badge-sm gap-1"><%= icon("warning", size: 12) %> Check</div>
              <% end %>
              <span class="text-sm font-mono opacity-50 w-12"><%= log.entered_at.strftime("%H:%M") %></span>
            </div>

          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="flex-1 flex items-center justify-center py-10 opacity-40 text-sm">
        Nessun ingresso registrato oggi.
      </div>
    <% end %>
  </div>

  <%# COLONNA 2: Scadenze (Task list) %>
  <div class="flex flex-col bg-base-100 rounded-2xl shadow-sm p-5 md:p-6">
    <h2 class="text-base font-bold flex items-center gap-2 mb-6">
      <%= icon("schedule", size: 18, class: "text-warning opacity-80") %> In Scadenza
    </h2>

    <% if @expiring_subscriptions.any? %>
      <ul class="flex-1 flex flex-col gap-3">
        <% @expiring_subscriptions.each do |sub| %>
          <li class="flex flex-col gap-2 p-3 rounded-xl bg-base-200/40 border border-base-200">
            <div class="flex justify-between items-start">
              <span class="text-sm font-semibold"><%= link_to sub.member.full_name, sub.member, class: "hover:underline" %></span>
              <span class="text-xs font-mono opacity-60"><%= sub.end_date.strftime("%d/%m") %></span>
            </div>
            <%= link_to new_sale_path(member_id: sub.member_id), class: "btn btn-xs btn-outline w-full mt-1" do %>
              Rinnova Abbonamento
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if @expiring_count > 5 %>
         <div class="mt-4 text-center">
           <%= link_to "Mostra altre (#{@expiring_count - 5})", subscriptions_path(filter: 'expiring'), class: "text-xs font-semibold link link-primary" %>
         </div>
      <% end %>
    <% else %>
      <div class="flex-1 flex flex-col items-center justify-center py-8 text-sm opacity-40 gap-2">
        <%= icon("done_all", size: 24) %>
        Nessuna urgenza.
      </div>
    <% end %>
  </div>

</div>

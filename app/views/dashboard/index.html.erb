<%= turbo_stream_from "attendances" %>
<%= turbo_stream_from "members" %>
<%= turbo_stream_from "sales" %>

<header class="flex flex-col sm:flex-row gap-4 justify-between sm:items-center mb-8">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">Buongiorno, <%= current_user.first_name %> 👋</h1>
    <p class="text-sm text-base-content/60 mt-1">Situazione operativa della struttura.</p>
  </div>
  <%= link_to new_sale_path, class: "btn btn-primary", data: { turbo_frame: "modal" } do %>
    <%= icon("add") %> Nuova Vendita
  <% end %>
</header>

<div class="stats stats-vertical lg:stats-horizontal bg-base-100 border border-base-200 shadow-sm w-full mb-8">
  <% [ [ "Cash Mattina", format_cents(@daily_cash.morning_cents), "sunny", "text-success/50" ],
       [ "Cash Pomeriggio", format_cents(@daily_cash.afternoon_cents), "moon", "text-success/50" ],
       [ "Da regolarizzare", @unenrolled.size, "group", nil, ("text-error" if @unenrolled.any?) ],
       [ "Scadenze (7gg)", @expiring_count, "notification_important", nil, ("text-warning" if @expiring_count > 0) ] ].each do |title, value, icon_name, figure, alert| %>
    <div class="stat">
      <div class="stat-figure <%= figure || alert || "text-base-content/30" %>"><%= icon(icon_name, classes: "size-8") %></div>
      <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest"><%= title %></div>
      <div class="stat-value text-xl md:text-2xl <%= alert %>"><%= value %></div>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
  <%= render layout: "shared/panel", locals: { title: "Ultimi pagamenti", icon_name: "payments",
                                               aside: (link_to("Vedi tutti", sales_path, class: "link link-hover text-xs opacity-60") if current_user.admin?) } do %>
    <% if @recent_sales.any? %>
      <ul class="list">
        <%= render partial: "dashboard/recent_sale", collection: @recent_sales, as: :sale, cached: ->(sale) { [ sale, sale.member ] } %>
      </ul>
    <% else %>
      <%= render "shared/empty_state", compact: true, icon_name: "payments", title: "Nessun pagamento registrato" %>
    <% end %>
  <% end %>

  <%= render layout: "shared/panel", locals: { title: "Prossime scadenze", icon_name: "event",
                                               aside: (link_to("Tutte (#{@expiring_count})", subscriptions_path(filter: "expiring"), class: "link link-hover text-xs opacity-60") if @expiring_count > 5) } do %>
    <% if @expiring_subscriptions.any? %>
      <ul class="list">
        <%= render partial: "dashboard/expiring_subscription", collection: @expiring_subscriptions, as: :sub, cached: ->(sub) { [ sub, sub.member, sub.product ] } %>
      </ul>
    <% else %>
      <%= render "shared/empty_state", compact: true, icon_name: "success", title: "Nessun abbonamento in scadenza" %>
    <% end %>
  <% end %>

  <div class="lg:col-span-2">
    <%= render layout: "shared/panel", locals: { title: "Frequentano senza abbonamento a #{l(Date.current, format: "%B")}", icon_name: "group", id: "unenrolled_attendances" } do %>
      <% if @unenrolled.any? %>
        <ul class="list">
          <%= render partial: "dashboard/unenrolled_attendance", collection: @unenrolled, as: :attendance, locals: { products_to_sell: @products_to_sell },
                     cached: ->(attendance) { [ attendance, attendance.member, attendance.discipline, @products_to_sell[attendance] ] } %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", compact: true, icon_name: "success", title: "Chi frequenta è iscritto: nessuno da regolarizzare" %>
      <% end %>
    <% end %>
  </div>
</div>

<%= turbo_stream_from "access_logs" %>
<%= turbo_stream_from "subscriptions" %>
<%= turbo_stream_from "sales" %>

<header class="flex flex-col sm:flex-row gap-4 justify-between sm:items-center mb-8">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-base-content">
      Buongiorno, <%= Current.session.user.first_name %> 👋
    </h1>
    <p class="text-sm text-base-content/60 mt-1">
      Situazione operativa della struttura.
    </p>
  </div>

  <%= link_to new_sale_path, class: "btn btn-primary", data: { turbo_frame: "modal" } do %>
    <%= icon("add") %> Nuova Vendita
  <% end %>
</header>

<div class="stats stats-vertical lg:stats-horizontal bg-base-100 border-base-300 shadow-sm w-full mb-8">

  <div class="stat">
    <div class="stat-figure text-success/50"><%= icon("sunny", classes: "size-8") %></div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Cash Mattina</div>
    <div class="stat-value text-xl md:text-2xl"><%= format_money(@daily_cash.morning_total) %></div>
  </div>

  <div class="stat">
    <div class="stat-figure text-success/50"><%= icon("moon", classes: "size-8") %></div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Cash Pomeriggio</div>
    <div class="stat-value text-xl md:text-2xl"><%= format_money(@daily_cash.afternoon_total) %></div>
  </div>

  <div class="stat">
    <div class="stat-figure text-info/50"><%= icon("access", classes: "size-8") %></div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Ingressi Oggi</div>
    <div class="stat-value text-xl md:text-2xl"><%= @today_accesses_count %></div>
  </div>

  <div class="stat">
    <div class="stat-figure <%= @expiring_count > 0 ? 'text-warning' : 'text-base-content/30' %>">
      <%= icon("notification_important", classes: "size-8") %>
    </div>
    <div class="stat-title text-[0.65rem] font-bold uppercase tracking-widest opacity-60">Scadenze (7gg)</div>
    <div class="stat-value text-xl md:text-2xl <%= 'text-warning' if @expiring_count > 0 %>"><%= @expiring_count %></div>
  </div>

</div>

<%# RIGA 2: FEED COMMERCIALE (Pagamenti e Scadenze) %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

  <%# COLONNA: Ultimi Pagamenti %>
  <div class="card bg-base-100 shadow-sm border border-base-200">
    <div class="card-body p-4 md:p-6">
      <div class="flex justify-between items-center mb-2">
        <h2 class="card-title text-base flex items-center gap-2">
          <%= icon("payments", classes: "size-5 text-success") %> Ultimi Pagamenti
        </h2>
        <% if current_user.admin? %>
          <%= link_to "Vedi tutti", sales_path, class: "text-xs font-semibold link link-hover text-base-content/60" %>
        <% end %>
      </div>

      <% if @recent_sales.any? %>
        <ul class="list bg-base-100/50 rounded-box">
          <%= render partial: "dashboard/recent_sale", collection: @recent_sales, as: :sale, cached: true %>
        </ul>
      <% else %>
        <div class="flex items-center justify-center py-10 text-base-content/40 text-sm">
          Nessun pagamento registrato.
        </div>
      <% end %>
    </div>
  </div>

  <%# COLONNA: Scadenze (Rinnovi da fare) %>
  <div class="card bg-base-100 shadow-sm border border-base-200">
    <div class="card-body p-4 md:p-6">
      <h2 class="card-title text-base flex items-center gap-2 mb-2">
        <%= icon("event", classes: "size-6 text-warning") %> Prossime Scadenza
      </h2>

      <% if @expiring_subscriptions.any? %>
        <ul class="list bg-base-100/50 rounded-box">
          <%= render partial: "dashboard/expiring_subscription", collection: @expiring_subscriptions, as: :sub, cached: true %>
        </ul>

        <% if @expiring_count > 5 %>
          <div class="mt-4 text-center">
            <%= link_to "Mostra tutte le scadenze (#{@expiring_count})", subscriptions_path(filter: 'expiring'), class: "btn btn-ghost btn-sm text-xs font-semibold" %>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center py-8 text-sm text-base-content/40 gap-3">
          <%= icon("success", classes: "size-10 opacity-20") %>
          <span>Nessun abbonamento in scadenza.</span>
        </div>
      <% end %>
    </div>
  </div>

  <%# RIGA 3: FEED OPERATIVO (Accessi) - Prende tutta la larghezza %>
  <div class="card bg-base-100 shadow-sm border border-base-200 lg:col-span-2">
    <div class="card-body p-4 md:p-6">
      <div class="flex justify-between items-center mb-2">
        <h2 class="card-title text-base flex items-center gap-2">
          <%= icon("history", classes: "size-5 opacity-50") %> Registro Accessi Recenti
        </h2>
        <% if current_user.admin? %>
          <%= link_to "Vedi registro completo", access_logs_path, class: "text-xs font-semibold link link-hover text-base-content/60" %>
        <% end %>
      </div>

      <% if @recent_accesses.any? %>
        <%# Qui potresti anche valutare una griglia interna se gli accessi sono tanti,
        ma la lista DaisyUI che abbiamo creato è molto pulita %>
        <ul class="list bg-base-100/50 rounded-box">
          <%= render partial: "dashboard/recent_access", collection: @recent_accesses, as: :log, cached: true %>
        </ul>
      <% else %>
        <div class="flex items-center justify-center py-10 text-base-content/40 text-sm">
          Nessun ingresso registrato oggi.
        </div>
      <% end %>
    </div>
  </div>

</div>

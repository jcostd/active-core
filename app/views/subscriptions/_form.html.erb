<%= form_with(model: subscription, class: "space-y-6") do |f| %>
  <%= render "shared/form_errors", model: subscription %>

  <div class="bg-base-200/30 rounded-box border border-base-300 overflow-hidden mb-4">
    <div class="grid grid-cols-2 divide-x divide-base-300">

      <div class="flex flex-col justify-center items-center p-3 text-center min-w-0">
        <div class="text-primary mb-1"><%= icon("badge", classes: "size-5") %></div>
        <div class="text-[10px] uppercase font-bold text-base-content/50 leading-none mb-0.5">Socio</div>
        <div class="text-sm font-bold w-full truncate px-1" title="<%= subscription.member.full_name %>">
          <%= subscription.member.full_name %>
        </div>
      </div>

      <div class="flex flex-col justify-center items-center p-3 text-center min-w-0">
        <div class="text-secondary mb-1"><%= icon("shopping_cart", classes: "size-5") %></div>
        <div class="text-[10px] uppercase font-bold text-base-content/50 leading-none mb-0.5">Prodotto</div>
        <div class="text-sm font-bold w-full truncate px-1" title="<%= subscription.product.name %>">
          <%= subscription.product.name %>
        </div>
      </div>
    </div>
  </div>

  <fieldset class="fieldset">
    <legend class="fieldset-legend font-bold text-base flex items-center gap-2">
      <%= icon("calendar_today", classes: "size-4") %> Periodo di Validità
    </legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
      <div>
        <%= f.label :start_date, "Data Inizio*", class: "label" %>
        <%= f.date_field :start_date, class: "input w-full", required: true %>
      </div>

      <div>
        <%= f.label :end_date, "Data Scadenza*", class: "label" %>
        <%= f.date_field :end_date, class: "input w-full" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend font-bold text-base flex items-center gap-2">
      <%= icon("payments", classes: "size-4") %> Prezzo Concordato
    </legend>

    <label class="input w-full">
      <%= icon("euro_symbol", classes: "size-4 opacity-50") %>
      <%= f.text_field :agreed_price, value: number_with_precision(subscription.agreed_price, precision: 2, separator: ",", delimiter: ""),
                                      inputmode: "decimal", autocomplete: "off", class: "grow" %>
    </label>
    <p class="label whitespace-normal">
      Già incassati <%= format_cents(subscription.amount_paid) %>. Abbassarlo chiude il debito residuo (abbuono): non restituisce denaro.
    </p>
  </fieldset>

  <div class="modal-action">
    <%= f.submit "Salva",
     class: "btn btn-primary px-4",
     data: { turbo_submits_with: 'Salvataggio...' } %>
  </div>
<% end %>

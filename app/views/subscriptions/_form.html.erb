<%= form_with model: subscription, class: "flex flex-col gap-4" do |f| %>
  <%= render "shared/form_errors", model: subscription %>

  <%= render "shared/details", rows: { "Socio" => subscription.member.full_name, "Prodotto" => subscription.product.name } %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("calendar_today", classes: "size-4") %> Periodo</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
      <div>
        <%= f.label :start_date, "Decorrenza*" %>
        <%= f.date_field :start_date, required: true %>
      </div>
      <div>
        <%= f.label :end_date, "Scadenza*" %>
        <%= f.date_field :end_date %>
      </div>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("payments", classes: "size-4") %> Prezzo concordato</legend>
    <label class="input w-full">
      <%= icon("euro_symbol", classes: "size-4 opacity-50") %>
      <%= f.text_field :agreed_price, value: number_with_precision(subscription.agreed_price, precision: 2, separator: ",", delimiter: ""),
                                      inputmode: "decimal", autocomplete: "off", class: "grow" %>
    </label>
    <p class="label whitespace-normal">
      Già incassati <%= format_cents(subscription.amount_paid) %>. Abbassarlo chiude il debito residuo (abbuono): non restituisce denaro.
    </p>
  </fieldset>

  <div class="modal-action"><%= f.submit %></div>
<% end %>

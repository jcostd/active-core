<%# locals: (subscription:) %>

<div class="flex items-center justify-between py-3 border-b border-base-200 last:border-0">
  <div class="flex flex-col">
    <span class="font-bold text-base-content"><%= subscription.product.name %></span>
    <span class="text-xs opacity-70 mt-0.5">
      <%= subscription.start_date&.strftime("%d/%m/%Y") %> &rarr; <%= subscription.end_date&.strftime("%d/%m/%Y") %>
    </span>
  </div>

  <div class="shrink-0">
    <%= render "subscriptions/badge", subscription: subscription %>
  </div>
</div>

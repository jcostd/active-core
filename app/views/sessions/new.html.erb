<div class="hero min-h-screen relative bg-base-100">
  <div class="hero-content flex-col lg:flex-row-reverse gap-12 relative">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold">Accedi qui</h1>
      <p class="py-6">per utilizzare il sistema ActiveCore</p>
    </div>

    <%= form_with url: session_url, class: "contents" do |form| %>
      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-md border p-4">
        <legend class="fieldset-legend">Accesso</legend>

        <%= form.label :username %>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", value: params[:username] %>

        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>

        <%= form.submit "Entra", class: "btn btn-neutral mt-4" %>
      </fieldset>
    <% end %>
  </div>
</div>

<%# locals: (sale:, with_member: true) %>
<%= render layout: "shared/row", locals: {
      record: sale, title: sale.product_name_snapshot, figure: row_icon("receipt"), archived_label: "Annullata", archive_title: "Annulla pagamento",
      archive_confirm: ("Annullare questo pagamento? Se è l'unico dell'abbonamento, verrà annullato anche l'abbonamento." if sale.reversible_by?(current_user)),
      aside: tag.div(safe_join([ tag.span(format_money(sale.amount), class: "font-mono font-bold text-lg text-primary"), payment_method_badge(sale.payment_method) ]),
                     class: "flex flex-col items-end gap-1") } do %>
  <div class="text-xs opacity-70 flex flex-wrap items-center gap-x-2">
    <span class="font-bold"><%= format_date(sale.sold_on) %></span>
    <% if sale.receipt_code %>
      <span class="font-mono" title="Ricevuta">#<%= sale.receipt_code %></span>
    <% end %>
    <% if with_member %>
      <%= link_to sale.member.full_name, sale.member, class: "link link-hover font-medium", data: { turbo_frame: "_top" } %>
    <% end %>
    <span>op. <%= sale.user.username %></span>
  </div>
  <% if sale.subscription %>
    <div class="text-xs flex flex-wrap items-center gap-1">
      <%= icon("calendar_today", classes: "size-3 opacity-60") %> <%= format_date(sale.subscription.start_date) %> → <%= format_date(sale.subscription.end_date) %>
      <%= render "subscriptions/badge", subscription: sale.subscription %>
    </div>
  <% end %>
  <% if sale.notes.present? %>
    <div class="text-xs italic opacity-50 truncate"><%= sale.notes %></div>
  <% end %>
<% end %>

<%= turbo_stream_from "sales" %>
<%= render "shared/page_header", title: "Vendite", counter: "#{Sale.kept.count} totali", new_path: new_sale_path, new_label: "Nuova" %>

<%= render layout: "shared/filter/form",
           locals: { url: sales_path, frame: "sales_list", placeholder: "Cerca n. ricevuta o socio...", drawer_title: "Filtri Vendite" } do %>
  <%= filter_select :state, [ [ "Valide", "active" ], [ "Annullate", "discarded" ] ], label: "Stato Ricevuta", blank: "Tutte" %>
  <%= filter_select :period, [ [ "Oggi", "today" ], [ "Questo Mese", "this_month" ], [ "Mese Scorso", "last_month" ], [ "Quest'Anno", "this_year" ] ],
                    label: "Periodo", blank: "Sempre" %>
  <%= filter_select :payment_method, payment_method_options, label: "Metodo di Pagamento", blank: "Qualsiasi" %>
  <%= filter_select :accounting_category, [ [ "Istituzionale", "institutional" ], [ "Associativo", "associative" ] ],
                    label: "Categoria Contabile", blank: "Qualsiasi" %>
  <%= filter_select :operator_id, User.kept.operators.order(:username).pluck(:username, :id), label: "Operatore", blank: "Tutti gli operatori" %>
<% end %>

<%= render layout: "shared/list", locals: { frame: "sales_list", records: @sales, icon_name: "receipt", empty: "Nessuna vendita trovata",
                                            filter_keys: %i[sort state period payment_method accounting_category operator_id] } do %>
  <ul id="sales" class="list panel">
    <%= render partial: "sales/row", collection: @sales, as: :sale, cached: ->(sale) { [ sale, sale.member, sale.reversible_by?(current_user) ] } %>
  </ul>
<% end %>

<%# app/views/sales/show.html.erb %>
<%= turbo_stream_from @sale %>

<%# --- HEADER CONTEXT --- %>
<%= render "sales/context", sale: @sale %>

<%# --- CONTENUTO PRINCIPALE --- %>
<div class="w-full max-w-6xl mx-auto mt-6 space-y-8">

  <%# --- 1. HERO: STATS COMPONENT (Disteso e nativo DaisyUI) --- %>
  <div class="stats stats-vertical md:stats-horizontal w-full bg-base-100 shadow-sm border border-base-200">

    <%# Stat 1: Prodotto %>
    <div class="stat">
      <div class="stat-figure text-base-content/30">
        <%= transaction_status_indicator(@sale) %>
      </div>
      <div class="stat-title">Acquistato il <%= format_date(@sale.sold_on) %></div>
      <div class="stat-value text-2xl lg:text-4xl text-wrap mt-1">
        <%= display_value(@sale.product_name_snapshot) %>
      </div>
      <div class="stat-desc mt-2">
        <% if @sale.product %>
          <%= link_to "Vedi prodotto collegato", [@sale.product], class: "link link-hover", data: { turbo_frame: "_top" } %>
        <% else %>
          Prodotto non più a catalogo
        <% end %>
      </div>
    </div>

    <%# Stat 2: Importo %>
    <div class="stat md:w-1/3 border-t md:border-t-0 md:border-l border-base-200">
      <div class="stat-figure text-primary/30">
        <%= payment_method_icon(@sale.payment_method, classes: "size-8") %>
      </div>
      <div class="stat-title capitalize"><%= display_value(@sale.payment_method.humanize) %></div>
      <div class="stat-value text-primary font-mono mt-1">
        <%= format_money(@sale.amount) %>
      </div>
    </div>

  </div>

  <%# --- 2. DETTAGLI: LIST COMPONENT (Moderno e coerente) --- %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <%# COLONNA SINISTRA %>
    <div class="space-y-6">

      <%# Riferimenti %>
      <div>
        <h2 class="px-4 text-xs font-bold uppercase opacity-50 mb-2">Riferimenti Documento</h2>
        <ul class="list bg-base-100 rounded-box shadow-sm border border-base-200 w-full text-sm">
          <li class="list-row justify-between items-center">
            <span class="opacity-70">Numero Ricevuta</span>
            <span class="font-mono font-bold"><%= display_value(@sale.receipt_code, placeholder: "N/A") %></span>
          </li>
          <li class="list-row justify-between items-center">
            <span class="opacity-70">Anno Fiscale</span>
            <span class="font-mono"><%= display_value(@sale.receipt_year) %></span>
          </li>
          <li class="list-row justify-between items-center">
            <span class="opacity-70">Sequenza / Categoria</span>
            <span class="font-mono"><%= display_value(@sale.receipt_sequence) %></span>
          </li>
        </ul>
      </div>

      <%# Note %>
      <% if @sale.notes.present? %>
        <div>
          <h2 class="px-4 text-xs font-bold uppercase opacity-50 mb-2">Note Transazione</h2>
          <div class="card bg-base-100 shadow-sm border border-base-200">
            <div class="card-body p-5 text-sm italic opacity-80 leading-relaxed">
              <%= @sale.notes %>
            </div>
          </div>
        </div>
      <% end %>

    </div>

    <%# COLONNA DESTRA %>
    <div>
      <h2 class="px-4 text-xs font-bold uppercase opacity-50 mb-2">Soggetti Coinvolti</h2>
      <ul class="list bg-base-100 rounded-box shadow-sm border border-base-200 w-full">

        <%# Acquirente %>
        <li class="list-row items-center gap-4 py-4">
          <div class="shrink-0">
            <%= ui_avatar(@sale.member, size: "size-10") %>
          </div>
          <div class="grow min-w-0">
            <div class="text-xs uppercase opacity-50 mb-0.5">Acquirente</div>
            <div class="font-bold truncate text-base">
              <%= link_to @sale.member.full_name, member_path(@sale.member), class: "hover:underline", data: { turbo_frame: "_top" } %>
            </div>
          </div>
        </li>

        <%# Operatore %>
        <li class="list-row items-center gap-4 py-4">
          <div class="shrink-0">
            <%= ui_avatar(@sale.user, size: "size-10") %>
          </div>
          <div class="grow min-w-0">
            <div class="text-xs uppercase opacity-50 mb-0.5">Operatore</div>
            <div class="font-bold truncate text-base">
              <%= display_value(@sale.user.full_name) %>
            </div>
          </div>
        </li>

      </ul>
    </div>

  </div>
</div>

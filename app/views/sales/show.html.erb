<%= turbo_stream_from @sale %>

<%= render layout: "shared/record_header", locals: {
      title: "Vendita del #{format_date(@sale.sold_on)}", avatar: icon("receipt", classes: "size-14 opacity-50"),
      badges: safe_join([ tag.span("Rif: #{@sale.receipt_code.presence || "N/A"}", class: "font-mono text-sm opacity-70"),
                          @sale.discarded? ? ui_badge("Annullata", tone: :error) : ui_badge("Confermata", tone: :success) ], " ") } do %>
  <% unless @sale.discarded? %>
    <%= header_button "Stampa", sale_path(@sale, format: :pdf), "print", tone: "btn-primary", target: "_blank", data: { turbo: false } %>
    <%= header_archive_button "Annulla", sale_path(@sale),
          confirm: "Annullare questo pagamento? Se è l'unico dell'abbonamento, verrà annullato anche l'abbonamento." if @sale.reversible_by?(current_user) %>
  <% end %>
<% end %>

<div class="w-full max-w-6xl mx-auto mt-6 flex flex-col gap-6">
  <div class="stats stats-vertical md:stats-horizontal w-full bg-base-100 shadow-sm border border-base-200">
    <div class="stat">
      <div class="stat-title">Acquistato il <%= format_date(@sale.sold_on) %></div>
      <div class="stat-value text-2xl lg:text-4xl text-wrap"><%= @sale.product_name_snapshot %></div>
      <% if @sale.product.nil? %>
        <div class="stat-desc">Prodotto non più a catalogo</div>
      <% elsif current_user.admin? %>
        <div class="stat-desc"><%= link_to "Vedi prodotto", @sale.product, class: "link link-hover" %></div>
      <% end %>
    </div>

    <div class="stat md:w-1/3">
      <div class="stat-figure text-primary/30"><%= payment_method_icon(@sale.payment_method, classes: "size-8") %></div>
      <div class="stat-title"><%= payment_method(@sale.payment_method)[:label] %></div>
      <div class="stat-value text-primary font-mono"><%= format_money(@sale.amount) %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
    <%= render layout: "shared/panel", locals: { title: "Ricevuta", icon_name: "receipt" } do %>
      <%= render "shared/details", rows: { "Numero" => (tag.span(@sale.receipt_code, class: "font-mono font-bold") if @sale.receipt_code),
                                            "Anno fiscale" => @sale.receipt_year, "Serie" => { "associative" => "Quote associative", "institutional" => "Quote istituzionali" }[@sale.receipt_sequence] } %>
    <% end %>

    <%= render layout: "shared/panel", locals: { title: "Chi", icon_name: "group" } do %>
      <%= render "shared/details", rows: { "Socio" => link_to(@sale.member.full_name, @sale.member, class: "link link-hover font-bold"),
                                            "Operatore" => @sale.user.full_name, "Note" => @sale.notes } %>
    <% end %>
  </div>
</div>

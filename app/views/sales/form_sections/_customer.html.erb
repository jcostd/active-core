<fieldset class="fieldset">
  <legend class="fieldset-legend"><%= icon("person_search", classes: "size-4") %> Socio</legend>

  <% if is_installment %>
    <%= f.hidden_field :member_id %>
    <input type="text" class="input w-full" value="<%= sale.member&.full_name %>" aria-label="Socio" disabled>
    <p class="label text-info">Il socio non cambia: stai saldando una rata</p>
  <% else %>
    <div data-controller="autocomplete" data-action="click@window->autocomplete#clickOutside" class="relative">
      <%= f.hidden_field :member_id, data: { autocomplete_target: "hidden", action: "change->autosubmit#submit" } %>
      <input type="text" name="members_search" class="input w-full" placeholder="Cerca per nome o codice fiscale..."
             value="<%= sale.member&.full_name %>" autocomplete="off" aria-label="Cerca socio"
             data-autocomplete-target="input" data-action="input->autocomplete#search keyup->autocomplete#clearIfEmpty"
             data-url="<%= members_searches_path %>">
      <turbo-frame id="member_search_results" data-autocomplete-target="frame"></turbo-frame>
    </div>
  <% end %>
</fieldset>

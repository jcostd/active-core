<div class="fieldset">
  <div class="text-lg font-bold text-base-content mb-3 flex items-center gap-2">
    <%= icon("shopping_bag", classes: "size-6 opacity-40") %> Dettagli Acquisto
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="sm:col-span-2">
      <%= f.label :product_id, "Prodotto Selezionato", class: "label text-xs font-semibold uppercase opacity-70" %>
      <% if is_installment %>
        <%= f.hidden_field :product_id %>
        <input type="text" class="input w-full bg-base-200 text-base-content/70 cursor-not-allowed" value="<%= sale.product&.name %>" disabled>
      <% else %>
        <%= f.select :product_id,
	    grouped_options_for_select(grouped_product_options, sale.product_id),
	 { prompt: "Scegli un prodotto..." },
	 { class: "select w-full", data: { action: "change->autosubmit#submit" } } %>
      <% end %>
    </div>

    <div>
      <%= f.label :sold_on, "Data Contabile", class: "label text-xs font-semibold uppercase opacity-70" %>
      <% if current_user.admin? %>
        <%= f.date_field :sold_on, class: "input w-full", data: { action: "change->autosubmit#submit" } %>
      <% else %>
        <%= f.date_field :sold_on, class: "input w-full bg-base-200 text-base-content/70 cursor-not-allowed focus:outline-none", readonly: true %>
      <% end %>
    </div>

    <div>
      <%= f.label :payment_method, "Metodo di Pagamento", class: "label text-xs font-semibold uppercase opacity-70" %>
      <%= f.select :payment_method,
	  payment_method_options,
	  { prompt: "Seleziona metodo..." },
       class: "select w-full",
       data: { action: "change->autosubmit#submit" } %>
    </div>
  </div>

  <% unless is_installment %>
    <%= f.fields_for :subscription do |sub_f| %>
      <fieldset class="fieldset bg-base-200 border border-base-300 rounded-box p-4 mt-4">
        <% price = sale.subscription&.agreed_price || sale.product&.price %>
        <legend class="fieldset-legend"><%= current_user.admin? ? "Prezzo Concordato" : "Prezzo di Listino" %></legend>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <p class="label">
            <%= current_user.admin? ? "Applica uno sconto o un sovrapprezzo a questo acquisto." : "Il prezzo di listino non è modificabile." %>
          </p>

          <label class="input input-sm w-32 shrink-0">
            <%= icon("euro_symbol", classes: "size-4 opacity-50") %>
            <% if current_user.admin? %>
              <%= sub_f.text_field :agreed_price, value: price, autocomplete: "off", class: "text-right font-bold",
                                   data: { action: "change->autosubmit#submit" } %>
            <% else %>
              <input type="text" value="<%= format_money(price) %>" disabled class="text-right font-bold">
            <% end %>
          </label>
        </div>
      </fieldset>
    <% end %>
  <% end %>
</div>

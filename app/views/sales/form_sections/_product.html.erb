<fieldset class="fieldset">
  <legend class="fieldset-legend"><%= icon("shopping_bag", classes: "size-4") %> Acquisto</legend>

  <%= f.label :product_id, "Prodotto" %>
  <% if is_installment %>
    <%= f.hidden_field :product_id %>
    <input type="text" class="input w-full" value="<%= sale.product&.name %>" aria-label="Prodotto" disabled>
  <% else %>
    <%= f.select :product_id, grouped_options_for_select(grouped_product_options, sale.product_id), { prompt: "Scegli un prodotto..." },
                 data: { action: "change->autosubmit#submit" } %>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
    <div>
      <%= f.label :sold_on, "Data contabile" %>
      <%= f.date_field :sold_on, readonly: !current_user.admin?, data: { action: "change->autosubmit#submit" } %>
    </div>
    <div>
      <%= f.label :payment_method %>
      <%= f.select :payment_method, payment_method_options, { prompt: "Seleziona metodo..." }, data: { action: "change->autosubmit#submit" } %>
    </div>
  </div>

  <% unless is_installment %>
    <%= f.fields_for :subscription do |sub_f| %>
      <% price = sale.subscription&.agreed_price || sale.product&.price %>
      <div class="flex items-center justify-between gap-4 mt-3 p-4 bg-base-200 rounded-box">
        <div>
          <div class="font-bold"><%= current_user.admin? ? "Prezzo concordato" : "Prezzo di listino" %></div>
          <p class="label"><%= current_user.admin? ? "Uno sconto o un sovrapprezzo per questo acquisto." : "Il prezzo di listino non è modificabile." %></p>
        </div>
        <label class="input input-sm w-32 shrink-0">
          <%= icon("euro_symbol", classes: "size-4 opacity-50") %>
          <% if current_user.admin? %>
            <%= sub_f.text_field :agreed_price, value: price, autocomplete: "off", class: "text-right font-bold", data: { action: "change->autosubmit#submit" } %>
          <% else %>
            <input type="text" value="<%= format_money(price) %>" aria-label="Prezzo di listino" disabled class="text-right font-bold">
          <% end %>
        </label>
      </div>
    <% end %>
  <% end %>
</fieldset>

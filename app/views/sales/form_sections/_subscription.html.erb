<fieldset class="fieldset">
  <legend class="fieldset-legend"><%= icon("calendar_today", classes: "size-4") %> Validità</legend>

  <% if is_installment %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
      <div>
        <%= label_tag nil, "Decorrenza", class: "label" %>
        <%= date_field_tag nil, sale.subscription.start_date, class: "input w-full", readonly: true, aria: { label: "Decorrenza" } %>
      </div>
      <div>
        <%= label_tag nil, "Scadenza", class: "label" %>
        <%= date_field_tag nil, sale.subscription.end_date, class: "input w-full", readonly: true, aria: { label: "Scadenza" } %>
      </div>
    </div>
    <p class="label text-info">Le date non cambiano durante il saldo di una rata.</p>
  <% else %>
    <%= f.fields_for :subscription do |sub_f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
        <div>
          <%= sub_f.label :start_date, "Decorrenza (modificabile)" %>
          <%= sub_f.date_field :start_date, data: { action: "change->autosubmit#submit" },
                min: (sale.member.next_period_for(sale.product).start_date unless current_user.admin? || sale.member.nil? || sale.product.nil?) %>
        </div>
        <div>
          <% if current_user.admin? %>
            <% override_active = params[:override_end_date] == "1" %>
            <label class="<%= class_names("label", "text-warning": override_active) %>" for="override_end_date">
              <%= check_box_tag :override_end_date, "1", override_active, class: "checkbox checkbox-xs checkbox-warning", data: { action: "change->autosubmit#submit" } %>
              Forza scadenza (admin)
            </label>
            <%= sub_f.date_field :end_date, readonly: !override_active, class: class_names("input w-full", "input-warning": override_active),
                                 data: { action: "change->autosubmit#submit" } %>
          <% else %>
            <%= sub_f.label :end_date, "Scadenza (calcolata)" %>
            <%= sub_f.date_field :end_date, readonly: true %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if (warning = sale.membership_warning) %>
      <div role="alert" class="alert alert-warning alert-soft text-sm mt-3">
        <%= icon("warning", classes: "size-5") %> <span><%= warning %></span>
      </div>
    <% end %>
  <% end %>
</fieldset>

<!DOCTYPE html>
<html lang="it" data-theme="<%= current_theme %>">
  <%= render "layouts/head", title: page_title %>

  <body class="bg-base-200 antialiased" data-controller="theme-sync idle" data-theme-sync-theme-value="<%= current_theme %>"
        data-idle-timeout-value="<%= Session::IDLE_TIMEOUT.to_i %>" data-idle-url-value="<%= session_path(reason: "idle") %>">
    <div class="drawer mx-auto max-w-[100rem] lg:drawer-open">
      <input id="main-drawer" type="checkbox" class="drawer-toggle">

      <div class="drawer-content flex flex-col min-h-screen">
        <nav class="navbar sticky top-0 z-30 bg-base-200 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 print:hidden">
          <div class="flex-1">
            <label for="main-drawer" class="btn btn-square btn-ghost lg:hidden" aria-label="Menu"><%= icon("menu") %></label>
          </div>

          <%# due tendine esclusive (stesso name); si chiudono cliccando fuori o con Esc %>
          <details class="dropdown dropdown-end" name="navbar_menus" data-controller="dropdown"
                   data-action="click@window->dropdown#close keyup@window->dropdown#closeOnEscape">
            <summary class="btn btn-sm btn-ghost" title="Cambia tema" aria-label="Cambia tema"><%= icon("theme") %></summary>
            <ul class="dropdown-content menu bg-base-100 rounded-box shadow-lg mt-4 w-52 p-2">
              <li class="menu-title">Temi</li>
              <% UserPreferences::THEMES.each do |theme| %>
                <li>
                  <%= link_to preferences_theme_path(theme:), data: { turbo_method: :patch }, class: class_names("capitalize justify-between", "menu-active": theme == current_theme) do %>
                    <%= theme %> <%= icon("check") if theme == current_theme %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </details>

          <details class="dropdown dropdown-end" name="navbar_menus" data-controller="dropdown"
                   data-action="click@window->dropdown#close keyup@window->dropdown#closeOnEscape">
            <summary class="btn btn-sm btn-ghost gap-2" title="Menu utente" aria-label="Menu utente">
              <%= icon("account_circle") %> <span class="hidden sm:inline"><%= current_user.username %></span>
            </summary>
            <ul class="dropdown-content menu bg-base-100 rounded-box shadow-lg mt-4 w-60 p-2">
              <li class="menu-title"><%= user_role_label(current_user) %></li>
              <li><%= link_to user_path(current_user) do %><%= icon("user") %> Il mio profilo<% end %></li>
              <li><%= link_to session_path, class: "text-error", data: { turbo_method: :delete } do %><%= icon("logout") %> Esci<% end %></li>
            </ul>
          </details>
        </nav>

        <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <%= content_for?(:page) ? yield(:page) : yield %>
        </main>
      </div>

      <%= render "shared/sidebar" %>
    </div>

    <%= render "shared/flash" %>

    <%# un solo modale; permanente: gli aggiornamenti in tempo reale (morph) non lo toccano mai %>
    <%= turbo_frame_tag "modal", data: { turbo_permanent: true } %>
  </body>
</html>

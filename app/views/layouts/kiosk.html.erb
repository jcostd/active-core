<!DOCTYPE html>
<html>
  <head>
    <title>Kiosk - <%= content_for(:title) || "Active Core" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Active Core Kiosk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 text-base-content min-h-screen flex flex-col overscroll-none selection:bg-primary selection:text-primary-content">

    <%# NAVBAR NATIVA DAISYUI %>
    <div class="navbar bg-base-100 shadow-sm sticky top-0 z-50 px-4 md:px-8">
      <div class="navbar-start gap-4">
        <div class="text-primary">
          <%= icon("fitness_center", classes: "size-10") %>
        </div>
        <div>
          <h1 class="text-2xl font-black tracking-tight leading-none uppercase">Kiosk Accessi</h1>
          <p class="text-xs font-bold opacity-50 tracking-widest uppercase mt-1"><%= GymProfile.current&.name || "La Tua Palestra" %></p>
        </div>
      </div>

      <div class="navbar-end">
        <%= link_to root_path, class: "btn btn-ghost btn-circle", title: "Esci dal Kiosk" do %>
          <%= icon("logout", classes: "size-7") %>
        <% end %>
      </div>
    </div>

    <%# CONTENITORE PRINCIPALE %>
    <main class="flex-grow p-4 md:p-8 container mx-auto w-full flex flex-col gap-8">
      <%= yield %>
    </main>

    <%# TOAST NATIVO DAISYUI PER I FLASH (iPad friendly, non copre bottoni in basso) %>
    <div id="flash-container" class="toast toast-end toast-bottom z-[100]">
      <%= render "shared/flash" %>
    </div>

    <%= turbo_frame_tag "modal" %>
  </body>
</html>

<!DOCTYPE html>
<html lang="it" data-theme="<%= current_theme %>">
  <%= render "layouts/head", title: "Kiosk - #{page_title}", viewport: "width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0" %>

  <body class="bg-base-200 text-base-content min-h-screen flex flex-col overscroll-none selection:bg-primary selection:text-primary-content">

    <div class="navbar bg-base-100 shadow-sm sticky top-0 z-50 px-4 md:px-8">
      <div class="navbar-start gap-4">
        <div class="text-primary">
          <%= icon("fitness_center", classes: "size-10") %>
        </div>
        <div>
          <h1 class="text-2xl font-black tracking-tight leading-none uppercase">Registro Presenze</h1>
          <p class="text-xs font-bold opacity-50 tracking-widest uppercase mt-1"><%= GymProfile.current.name %></p>
        </div>
      </div>

      <div class="navbar-end">
        <%= link_to session_path, title: "Esci dal Kiosk", class: "btn btn-ghost btn-circle", data: { turbo_method: :delete } do %>
          <%= icon("logout") %>
        <% end %>
      </div>
    </div>

    <main class="flex-grow p-4 md:p-8 container mx-auto w-full flex flex-col gap-8">
      <%= yield %>
    </main>

    <%= render "shared/flash" %>
  </body>
</html>

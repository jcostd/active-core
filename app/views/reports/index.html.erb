<%= render "shared/page_header", title: "Report mensile", counter: "#{format_cents(@monthly_total_cents)} incassati" %>
<%= render "shared/section_header", title: l(@date, format: "%B %Y").capitalize, icon_name: "calendar_today", aside: render("shared/month_nav", month: @date) %>

<% if @daily_reports.all?(&:empty?) %>
  <%= render "shared/empty_state", icon_name: "calendar_today", title: "Nessun report in questo mese",
             message: "Non ci sono incassi in contanti registrati a #{l(@date, format: "%B %Y")}." %>
<% else %>
  <ul id="reports" class="list panel">
    <%= render partial: "reports/row", collection: @daily_reports, as: :report %>
  </ul>
<% end %>

<% content_for :page_title, "Dettaglio Incassi - #{l(@date, format: :short)}" %>

<div class="mb-2">
  <%= link_to reports_path(month: @date.strftime("%Y-%m")), class: "btn btn-ghost btn-sm gap-2 pl-0" do %>
    <%= icon("arrow_left") %> Torna a <%= l(@date, format: "%B %Y") %>
  <% end %>
</div>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b-2 border-base-200 pb-4">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Dettaglio Incassi</h1>
    <div class="text-lg font-mono opacity-60 mt-1">
      <%= l(@date, format: :long) %>
    </div>
  </div>

  <div class="text-right">
    <div class="text-xs font-bold uppercase tracking-widest opacity-50 mb-1">Totale Giornata</div>
    <div class="text-4xl font-mono font-bold text-primary"><%= format_cents(@daily_cash.total_cents) %></div>
  </div>
</div>

<div class="space-y-6">
  <%= render "reports/shift", title: "Mattina", hours: "00:00 - 13:59", icon_name: "sunny", icon_class: "text-warning",
                              sales: @daily_cash.morning_sales, cents: @daily_cash.morning_cents %>
  <%= render "reports/shift", title: "Pomeriggio", hours: "14:00 - 23:59", icon_name: "moon", icon_class: "text-info",
                              sales: @daily_cash.afternoon_sales, cents: @daily_cash.afternoon_cents %>
  <% if @daily_cash.late_sales.any? %>
    <%= render "reports/shift", title: "Registrate in seguito", hours: "Incassi di questo giorno inseriti in un altro giorno",
                                icon_name: "history", icon_class: "text-neutral",
                                sales: @daily_cash.late_sales, cents: @daily_cash.late_cents %>
  <% end %>
</div>

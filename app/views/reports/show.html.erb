<% content_for :page_title, "Dettaglio Incassi - #{l(@date, format: :short)}" %>

<%# --- Header Navigazione --- %>
<div class="mb-2">
  <%= link_to reports_path(month: @date.strftime("%Y-%m")), class: "btn btn-ghost btn-sm gap-2 pl-0" do %>
    <%= icon("arrow_left") %> Torna a <%= l(@date, format: "%B %Y") %>
  <% end %>
</div>

<%# --- Intestazione Report --- %>
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 border-b-2 border-base-200 pb-4">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Dettaglio Incassi</h1>
    <div class="text-lg font-mono opacity-60 mt-1">
      <%= l(@date, format: :long) %>
    </div>
  </div>

  <%# Totale netto in evidenza subito in alto %>
  <div class="text-right">
    <div class="text-xs font-bold uppercase tracking-widest opacity-50 mb-1">Totale Giornata</div>
    <div class="text-4xl font-mono font-bold text-primary"><%= format_money(@daily_cash.total) %></div>
  </div>
</div>

<%# --- RIEPILOGO TURNI --- %>
<div class="space-y-6">

  <%# --- BLOCCO MATTINA --- %>
  <div class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
    <div class="bg-base-200/30 px-5 py-4 border-b border-base-200 flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <%= icon("sunny", classes: "size-12 text-warning") %>
        <div>
          <h2 class="font-bold text-lg leading-none">Mattina</h2>
          <div class="text-xs opacity-50 mt-1">00:00 - 13:59</div>
        </div>
      </div>
      <div class="font-mono font-bold text-xl">
        <%= format_money(@daily_cash.morning_total) %>
      </div>
    </div>

    <ul class="list list-flush w-full text-sm">
      <% if @daily_cash.morning_sales.any? %>
        <% @daily_cash.morning_sales.each do |sale| %>
          <li class="list-row items-center p-4 border-b border-base-100 hover:bg-base-50 transition-colors">
            <div class="font-mono text-xs opacity-50 w-14 shrink-0"><%= l(sale.created_at, format: "%H:%M") %></div>
            <div class="grow min-w-0">
              <div class="font-semibold text-base truncate"><%= sale.member.full_name %></div>
              <div class="text-xs opacity-60 truncate mt-0.5"><%= sale.product_name_snapshot %></div>
            </div>
            <div class="font-mono font-bold text-base shrink-0 pl-3">
              <%= format_money(sale.amount) %>
            </div>
          </li>
        <% end %>
      <% else %>
        <li class="p-8 text-center opacity-40 italic">Nessun movimento registrato.</li>
      <% end %>
    </ul>
  </div>

  <%# --- BLOCCO POMERIGGIO --- %>
  <div class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
    <div class="bg-base-200/30 px-5 py-4 border-b border-base-200 flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <%= icon("moon", classes: "size-12 text-indigo-400") %>
        <div>
          <h2 class="font-bold text-lg leading-none">Pomeriggio</h2>
          <div class="text-xs opacity-50 mt-1">14:00 - 23:59</div>
        </div>
      </div>
      <div class="font-mono font-bold text-xl">
        <%= format_money(@daily_cash.afternoon_total) %>
      </div>
    </div>

    <ul class="list list-flush w-full text-sm">
      <% if @daily_cash.afternoon_sales.any? %>
        <% @daily_cash.afternoon_sales.each do |sale| %>
          <li class="list-row items-center p-4 border-b border-base-100 hover:bg-base-50 transition-colors">
            <div class="font-mono text-xs opacity-50 w-14 shrink-0"><%= l(sale.created_at, format: "%H:%M") %></div>
            <div class="grow min-w-0">
              <div class="font-semibold text-base truncate"><%= sale.member.full_name %></div>
              <div class="text-xs opacity-60 truncate mt-0.5"><%= sale.product_name_snapshot %></div>
            </div>
            <div class="font-mono font-bold text-base shrink-0 pl-3">
              <%= format_money(sale.amount) %>
            </div>
          </li>
        <% end %>
      <% else %>
        <li class="p-8 text-center opacity-40 italic">Nessun movimento registrato.</li>
      <% end %>
    </ul>
  </div>

</div>

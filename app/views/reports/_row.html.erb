<%# locals: (report:) %>
<% today = report.date == Date.current %>
<li class="<%= class_names("list-row items-center", "bg-primary/5": today) %>">
  <%= row_icon("calendar_today") %>
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <%= link_to format_date(report.date, format: :long), report_path("daily_cash", date: report.date), class: "font-bold capitalize hover:text-primary" %>
      <%= tag.span("Oggi", class: "badge badge-primary badge-xs font-bold uppercase") if today %>
    </div>
    <div class="text-xs font-semibold opacity-60 flex flex-wrap gap-x-2">
      <span>Mattina: <span class="font-mono"><%= format_cents(report.morning_cents) %></span></span>
      <span>Pomeriggio: <span class="font-mono"><%= format_cents(report.afternoon_cents) %></span></span>
      <% if report.late_sales.any? %>
        <span>Registrate in seguito: <span class="font-mono"><%= format_cents(report.late_cents) %></span></span>
      <% end %>
    </div>
  </div>
  <div class="flex flex-col items-end">
    <span class="hidden sm:block text-[10px] font-bold opacity-50 uppercase">Totale netto</span>
    <span class="font-bold font-mono text-lg text-primary"><%= format_cents(report.total_cents) %></span>
  </div>
</li>

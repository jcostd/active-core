<%= turbo_stream_from "access_logs" %>

<% content_for :page_title, "Registro Accessi" %>
<% content_for :page_counter, "#{@total_accesses} totali" %>

<% content_for :page_search_and_filters do %>
  <%= render layout: "shared/filter/form",
             locals: { url: access_logs_path, frame: "access_logs_list", placeholder: "Cerca per socio...", drawer_title: "Filtri Accessi",
                       default_sort: "date_desc", sort_options: [ [ "Più recenti", "date_desc" ], [ "Meno recenti", "date_asc" ] ] } do |form| %>
    <%= filter_select form, :status, AccessLogsHelper::ACCESS_LOG_STATUS_STYLES.map { |status, style| [ style[:label], status ] },
                      label: "Esito", blank: "Tutti gli esiti" %>
    <%= filter_select form, :discipline_id, Discipline.kept.order(:name).pluck(:name, :id), label: "Disciplina", blank: "Tutte le discipline" %>
  <% end %>
<% end %>

<%= render "shared/header/page" %>

<%= turbo_frame_tag "access_logs_list" do %>
  <%= render "shared/filter/active", filter_keys: @keys %>

  <div class="mt-6">
    <% if @access_logs.empty? %>
      <%= render "shared/empty_state",
                 icon_name: "login",
                 title: "Nessun accesso trovato",
                 message: "Non ci sono registrazioni che corrispondono ai criteri di ricerca." %>
    <% else %>

      <%= filtered_results_counter(@pagy) %>

      <ul id="access_logs" class="list bg-base-100 rounded-box shadow-sm">
        <%= render partial: "access_logs/row", collection: @access_logs, as: :access_log %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>
<% end %>

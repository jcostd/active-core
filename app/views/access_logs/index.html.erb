<%= turbo_stream_from "access_logs" %>

<% content_for :page_title, "Registro Accessi" %>
<% content_for :page_counter, "#{@total_accesses} totali" %>

<% content_for :page_search_and_filters do %>
  <%= form_with url: access_logs_path,
		method: :get,
		html: {
		  autocomplete: "off",
		  id: "filter-form",
		  data: {
		    controller: "autosubmit drawer",
		    turbo_frame: "access_logs_list",
		    turbo_action: "advance"
		  }
		} do |form| %>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 w-full mb-2">
      <div class="flex items-center gap-2 w-full md:w-1/2">
        <label class="input w-full">
          <%= icon("search", classes: "size-5 opacity-50") %>
          <%= form.search_field :query,
           value: params[:query],
           placeholder: "Cerca per socio...",
           class: "grow",
           data: { action: "input->autosubmit#submit" } %>
        </label>

        <button type="button" data-action="drawer#open" class="btn bg-base-100 gap-2 shrink-0">
          <%= icon("filter") %>
          <span class="hidden sm:inline">Filtri</span>
        </button>
      </div>

      <div class="w-full md:w-auto shrink-0">
	<%= render "shared/filter/sort",
		   form: form,
		   default_sort: "date_desc",
		   sort_options: [
		     ["Più recenti", "date_desc"],
		     ["Più lontano", "date_asc"],
		   ] %>
      </div>
    </div>

    <%= render "shared/filter/drawer", title: "Filtri Accessi" do %>
      <div class="space-y-6">
        <div>
          <%= form.label :status, "Stato Accesso", class: "label" %>
          <%= form.select :status,
              AccessLog.statuses.keys.map { |s| [s.titleize, s] },
           { include_blank: "Tutti gli stati", selected: params[:status] },
           { class: "select w-full", data: { action: "change->autosubmit#submit" } } %>
        </div>
        <div>
          <%= form.label :discipline_id, "Disciplina", class: "label" %>
          <%= form.collection_select :discipline_id,
              Discipline.kept.order(:name), :id, :name,
           { include_blank: "Tutte le discipline", selected: params[:discipline_id] },
           { class: "select w-full", data: { action: "change->autosubmit#submit" } } %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render "shared/header/page" %>

<%= turbo_frame_tag "access_logs_list" do %>
  <%= render "shared/filter/active", filter_keys: @keys %>

  <div class="mt-6">
    <% if @access_logs.empty? %>
      <%= render "shared/empty_state",
                 icon_name: "login",
                 title: "Nessun accesso trovato",
                 message: "Non ci sono registrazioni che corrispondono ai criteri di ricerca." %>
    <% else %>

      <%= filtered_results_counter(@pagy) %>

      <ul id="access_logs" class="list bg-base-100 rounded-box shadow-sm">
        <%= render partial: "access_logs/row", collection: @access_logs, as: :access_log %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>
<% end %>

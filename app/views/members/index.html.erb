<%= turbo_stream_from "members" %>

<% content_for :page_title, "Soci" %>

<% content_for :page_counter, "#{@total_active_members} totali" %>

<% content_for :page_actions do %>
  <%= link_to [:new, :member],
	      class: "btn btn-primary gap-2",
	      data: { turbo_frame: "modal" } do %>
    <%= icon("add") %>
    <span class="hidden sm:inline">Nuovo</span>
  <% end %>
<% end %>

<% content_for :page_search_and_filters do %>
  <%= render layout: "shared/filter/form",
             locals: { url: members_path, frame: "members_list", placeholder: "Cerca nome, email...", drawer_title: "Filtri Soci" } do |form| %>
    <%= filter_select form, :membership_status, member_membership_filters, label: "Stato Tesseramento", blank: "Tutti gli stati" %>
    <%= filter_select form, :med_cert, member_med_cert_filters, label: "Certificato Medico", blank: "Tutte le scadenze" %>
  <% end %>
<% end %>

<%= render "shared/header/page" %>

<%= turbo_frame_tag "members_list" do %>
  <%= render "shared/filter/active", filter_keys: [:membership_status, :med_cert] %>

  <div class="mt-6">
    <% if @members.empty? %>
      <%= render "shared/empty_state",
		 icon_name: "filter_off",
		 title: "Nessun socio trovato",
		 message: "Prova a cambiare i criteri di ricerca o rimuovere i filtri." %>
    <% else %>

      <%= filtered_results_counter(@pagy) %>

      <ul id="members" class="list bg-base-100 rounded-box shadow-sm">
	<%= render partial: "members/row", collection: @members, as: :member,
                   cached: ->(member) { [ member, member.subscriptions.map(&:product), current_user.admin?, Date.current ] } %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>

<% end %>

<%= turbo_stream_from "members" %>
<%= render "shared/page_header", title: "Soci", counter: "#{Member.kept.count} totali", new_path: new_member_path %>

<%= render layout: "shared/filter/form", locals: { url: members_path, frame: "members_list", placeholder: "Cerca nome, email...", drawer_title: "Filtri Soci" } do %>
  <%= filter_select :membership_status, member_membership_filters, label: "Stato Tesseramento", blank: "Tutti gli stati" %>
  <%= filter_select :med_cert, member_med_cert_filters, label: "Certificato Medico", blank: "Tutte le scadenze" %>
<% end %>

<%= render layout: "shared/list", locals: { frame: "members_list", records: @members, filter_keys: %i[membership_status med_cert], empty: "Nessun socio trovato" } do %>
  <ul id="members" class="list panel">
    <%= render partial: "members/row", collection: @members, as: :member,
               cached: ->(member) { [ member, member.subscriptions.map(&:product), current_user.admin?, Date.current ] } %>
  </ul>
<% end %>

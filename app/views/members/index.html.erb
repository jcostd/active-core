<%= turbo_stream_from "members" %>

<% content_for :page_title, "Soci" %>

<% content_for :page_counter, "#{@total_active_members} totali" %>

<% content_for :page_actions do %>
  <%= link_to [:new, :member],
	      class: "btn btn-primary gap-2",
	      data: { turbo_frame: "modal" } do %>
    <%= icon("add") %>
    <span class="hidden sm:inline">Nuovo</span>
  <% end %>
<% end %>

<% content_for :page_search_and_filters do %>
  <%= form_with url: members_path,
		method: :get,
		html: {
		  autocomplete: "off",
		  id: "filter-form",
		  data: { controller: "autosubmit" }
		} do |form| %>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 w-full mb-2">

      <div class="flex items-center gap-2 w-full md:w-1/2 lg:w-1/3">
        <label class="input flex items-center gap-2 w-full">
          <%= icon("search", classes: "size-5 opacity-50") %>

          <%= form.search_field :query,
           value: params[:query],
           placeholder: "Cerca nome, email...",
           class: "grow",
           data: { action: "input->autosubmit#submit" } %>
        </label>

        <label for="members-filters" class="btn btn-outline bg-base-100 border-base-300 gap-2 shrink-0">
          <%= icon("filter") %>
          <span class="hidden sm:inline">Filtri</span>
        </label>
      </div>

      <%# DESTRA: Ordinamento %>
      <div class="w-full md:w-auto shrink-0">
        <%= render "shared/filter/sort", form: form %>
      </div>

    </div>

    <%# IL CASSETTO DEI FILTRI %>
    <%= render "shared/filter/drawer", drawer_id: "members-filters", title: "Filtri Soci" do %>
      <div class="space-y-6">
        <fieldset>
          <label class="label font-bold text-sm">Stato Tesseramento</label>
          <%= form.select :membership_status, member_membership_filters,
              { include_blank: "Tutti gli stati", selected: params[:membership_status] },
           { class: "select select-bordered w-full", data: { action: "change->autosubmit#submit" } } %>
        </fieldset>

        <fieldset>
          <label class="label font-bold text-sm">Certificato Medico</label>
          <%= form.select :med_cert, member_med_cert_filters,
		   { include_blank: "Tutte le scadenze", selected: params[:med_cert] },
           { class: "select select-bordered w-full", data: { action: "change->autosubmit#submit" } } %>
        </fieldset>

        <fieldset>
          <label class="label font-bold text-sm">Stato in Archivio</label>
          <%= form.select :state, member_state_filters,
                   { include_blank: "Mostra solo Attivi", selected: params[:state] },
           { class: "select select-bordered w-full", data: { action: "change->autosubmit#submit" } } %>
        </fieldset>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render "shared/header/page" %>

<%= render "shared/filter/active", filter_keys: [:membership_status, :med_cert, :state] %>

<%# --- INIZIO LISTA --- %>
<div class="mt-6">
  <% if @members.empty? %>
    <%= render "shared/empty_state",
               icon_name: "filter_off",
               title: t("search.results.zero", default: "Nessun socio trovato"),
               message: t("search.results.hint", default: "Prova a cambiare i criteri di ricerca o rimuovere i filtri.") %>
  <% else %>

    <%# 2. Feedback contestuale della ricerca %>
    <% if @is_filtering %>
      <div class="mb-4 text-sm font-medium text-base-content/70">
        Trovati <%= @pagy.count %> risultati
      </div>
    <% end %>

    <ul id="members" class="list bg-base-100 rounded-box shadow-sm">
      <%= render partial: "member_row", collection: @members, as: :member %>
    </ul>

    <% if @pagy.pages > 1 %>
      <div class="mt-8 border-t border-base-200 pt-6 flex justify-center">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>

  <% end %>
</div>

<%# locals: (log:) %>

<li id="<%= dom_id(log) %>" class="list-row group hover:bg-base-200/50 transition-colors">

  <div class="shrink-0 self-start sm:self-center mt-1 sm:mt-0">
    <%= access_log_status_icon(log) %>
  </div>

  <div class="flex flex-col gap-1 min-w-0 grow">

    <div class="font-bold truncate text-base leading-none">
      <%= access_log_activity_name(log) %>
    </div>

    <div class="text-[11px] font-medium opacity-70 flex flex-wrap items-center gap-1.5 mt-0.5">
      <%= icon("clock", classes: "size-3") %>
      <span class="font-mono font-bold"><%= format_datetime(log.entered_at, format: "%d/%m/%Y %H:%M") %></span>

      <% if log.subscription.present? %>
        <span class="opacity-50 mx-1">&bull;</span>
        <%= icon("card_membership", classes: "size-3 opacity-70") %>
        <span class="truncate max-w-[200px]" title="<%= log.subscription.product.name %>">
          <%= log.subscription.product.name %>
        </span>
      <% end %>
    </div>

  </div>

  <div class="shrink-0 self-start sm:self-center">
    <%= access_log_status_badge(log) %>
  </div>

</li>

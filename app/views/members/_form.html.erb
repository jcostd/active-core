<%= form_with model: member, class: "flex flex-col gap-4" do |f| %>
  <%= render "shared/form_errors", model: member %>

  <fieldset class="fieldset" data-controller="fiscal-code">
    <legend class="fieldset-legend"><%= icon("badge", classes: "size-4") %> Dati anagrafici</legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
      <div>
        <%= f.label :first_name, "Nome*" %>
        <%= f.text_field :first_name, required: true, placeholder: "Mario" %>
      </div>
      <div>
        <%= f.label :last_name, "Cognome*" %>
        <%= f.text_field :last_name, required: true, placeholder: "Rossi" %>
      </div>
      <div>
        <%= f.label :fiscal_code, "Codice fiscale*" %>
        <%= f.text_field :fiscal_code, class: "input w-full uppercase font-mono", placeholder: "RSSMRA...",
                         data: { fiscal_code_target: "code", action: "input->fiscal-code#autofill" } %>
        <label class="label mt-2 text-xs">
          <%= f.check_box :fiscal_code_pending, checked: member.fiscal_code_pending?, class: "checkbox checkbox-xs" %>
          CF da completare (il socio non lo ha con sé)
        </label>
      </div>
      <div>
        <%= f.label :birth_date, "Data di nascita*" %>
        <%= f.date_field :birth_date, required: true, data: { fiscal_code_target: "birthDate" } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("home", classes: "size-4") %> Residenza</legend>

    <%= f.label :address, "Indirizzo" %>
    <%= f.text_field :address, placeholder: "Via Roma, 10" %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
      <div>
        <%= f.label :city, "Città" %>
        <%= f.text_field :city, placeholder: "Milano" %>
      </div>
      <div>
        <%= f.label :zip_code, "CAP" %>
        <%= f.text_field :zip_code, class: "input w-full font-mono", placeholder: "20100" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("contact_mail", classes: "size-4") %> Contatti e salute</legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
      <div>
        <%= f.label :email_address, "Email" %>
        <%= f.email_field :email_address, placeholder: "mario@esempio.com" %>
      </div>
      <div>
        <%= f.label :phone, "Telefono" %>
        <%= f.telephone_field :phone, placeholder: "333 1234567" %>
      </div>
    </div>

    <%= f.label :medical_certificate_expiry, "Scadenza certificato medico" %>
    <%= f.date_field :medical_certificate_expiry %>
    <p class="label">Vuoto se non l'ha ancora portato.</p>
  </fieldset>

  <div class="modal-action"><%= f.submit %></div>
<% end %>

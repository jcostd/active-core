<%# locals: (member:, valid_subscriptions: []) %>
<div id="<%= dom_id(member) %>" class="record-layout">
  <div class="flex flex-col gap-6">
    <%= render layout: "shared/panel", locals: { title: "Certificato medico", icon_name: "med" } do %>
      <div class="panel-body">
        <%= ui_status_badge(member.medical_certificate_valid?, icon_name: "success", invalid_text: "Scaduto o mancante",
                            valid_text: "Valido fino al #{format_date(member.medical_certificate_expiry)}") %>
        <%= link_to "Aggiorna data", edit_member_path(member), class: "btn btn-xs btn-outline", data: { turbo_frame: "modal" } %>
      </div>
    <% end %>

    <%= render layout: "shared/panel", locals: { title: "Anagrafica", icon_name: "badge" } do %>
      <%= render "shared/details", rows: {
            "Codice fiscale" => tag.span(member.fiscal_code || "da completare", class: "font-mono"),
            "Nato il" => (safe_join([ format_date(member.birth_date), tag.span(safe_join([ "(", format_time_ago(member.birth_date), ")" ]), class: "opacity-50") ], " ") if member.birth_date),
            "Telefono" => (format_phone(member.phone) if member.phone.present?),
            "Email" => (format_email(member.email_address) if member.email_address.present?),
            "Indirizzo" => member.full_address } %>
    <% end %>
  </div>

  <div class="record-main">
    <%= render layout: "shared/panel", locals: { title: "Abbonamenti", icon_name: "credit_card",
                                                 aside: link_to("Vedi tutti", member_subscriptions_path(member), class: "link link-hover text-xs opacity-60") } do %>
      <% if valid_subscriptions.any? %>
        <ul class="list">
          <% valid_subscriptions.each do |sub| %>
            <% expiring = sub.status == :expiring_soon %>
            <li class="<%= class_names("list-row items-center", "bg-warning/5": expiring) %>">
              <div class="<%= class_names("p-2 rounded-box", sub.future? ? "bg-info/10 text-info" : "bg-primary/10 text-primary") %>">
                <%= icon(sub.future? ? "clock" : "success") %>
              </div>
              <div class="list-col-grow min-w-0">
                <div class="font-bold truncate"><%= sub.product.name %></div>
                <div class="text-xs opacity-70">
                  <% if sub.future? %>
                    <span class="text-info">Inizia il <%= format_date(sub.start_date) %></span>
                  <% else %>
                    Scade il <strong><%= format_date(sub.end_date) %></strong>
                  <% end %>
                </div>
              </div>
              <% if sub.future? %>
                <%= ui_badge("Futuro", tone: :info) %>
              <% else %>
                <div class="flex items-center gap-4">
                  <div class="text-right hidden sm:block leading-none">
                    <div class="<%= class_names("text-2xl font-black font-mono", expiring ? "text-warning" : "opacity-20") %>"><%= sub.days_left %></div>
                    <div class="text-[9px] uppercase font-bold opacity-40">giorni</div>
                  </div>
                  <%= link_to icon("reset"), renew_sale_path(sub), title: "Rinnova", data: { turbo_frame: "modal" },
                              class: class_names("btn btn-sm btn-square", expiring ? "btn-primary" : "btn-ghost") %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", compact: true, icon_name: "shopping_cart", title: "Nessun abbonamento attivo",
                   action: link_to("Vendi abbonamento", new_sale_path(member_id: member.id), class: "btn btn-primary btn-sm btn-outline", data: { turbo_frame: "modal" }) %>
      <% end %>
    <% end %>
  </div>
</div>

<%= turbo_stream_from @member %>
<%= render "members/context", member: @member %>

<%= render "shared/section_header", title: "Storico abbonamenti", icon_name: "card_membership" %>

<div id="member_subscriptions_list">
  <% if @subscriptions.empty? %>
    <%= render "shared/empty_state",
               icon_name: "card_membership",
               title: "Nessun abbonamento",
               message: "Questo utente non ha ancora abbonamenti attivi o passati." %>
  <% else %>
    <ul class="list panel">
      <%= render partial: "members/subscriptions/row", collection: @subscriptions, as: :subscription,
                 cached: ->(subscription) { [ subscription, subscription.product, current_user.admin?, Date.current, subscription.discardable_by?(current_user) ] } %>
    </ul>

    <%= render "shared/pagination" %>
  <% end %>
</div>

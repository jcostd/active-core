<%# locals: (subscription:) %>
<% status, style = subscription.status, subscription_status_style(subscription) %>
<% sales = subscription.sales.reject(&:discarded?).sort_by(&:sold_on) %>
<% due = subscription.amount_due %>
<li id="<%= dom_id(subscription) %>" class="<%= class_names("list-row", "opacity-60 grayscale": status == :expired) %>">
  <div class="<%= class_names("p-2 rounded-box self-start", style[:tint]) %>"><%= icon(style[:icon]) %></div>

  <div class="list-col-grow flex flex-col gap-1">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-bold"><%= subscription.product.name %></span>
      <%= subscription_status_badge(subscription) %>
      <%= subscription_payment_badge(subscription) %>
    </div>
    <div class="text-xs opacity-70 flex items-center gap-1">
      <%= icon("calendar_today", classes: "size-3") %> <%= format_date(subscription.start_date) %> → <%= format_date(subscription.end_date) %>
      <%= tag.span("· #{subscription.days_left} gg rimasti", class: "font-mono") unless status == :expired %>
    </div>

    <% if sales.any? || due > 0 %>
      <div class="flex flex-col gap-1 border-l-2 border-base-300 pl-3 max-w-sm">
        <% sales.each do |sale| %>
          <div class="flex items-center justify-between text-xs">
            <span class="flex items-center gap-1.5">
              <%= payment_method_icon(sale.payment_method, classes: "size-3") %> <%= format_date(sale.sold_on) %>
              <%= link_to sale.receipt_code, sale, class: "link link-hover text-primary", data: { turbo_frame: "_top" } if sale.receipt_code %>
            </span>
            <span class="font-mono"><%= format_money(sale.amount) %></span>
          </div>
        <% end %>
        <% if due > 0 %>
          <div class="flex items-center justify-between bg-warning/10 text-warning px-2 py-1.5 rounded-box">
            <span class="text-xs font-bold">Resta: <%= format_cents(due) %></span>
            <%= link_to new_sale_path(member_id: subscription.member_id, installment_for_subscription_id: subscription.id),
                        class: "btn btn-xs btn-warning btn-soft", title: "Incassa rata", data: { turbo_frame: "modal" } do %>
              <%= icon("payments", classes: "size-3") %> Incassa
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center self-start">
    <% if status.in?(%i[expired expiring_soon]) && !subscription.renewed? %>
      <%= link_to icon("reset"), renew_sale_path(subscription), class: "btn btn-square btn-sm btn-ghost text-info", title: "Rinnova", data: { turbo_frame: "modal" } %>
    <% end %>
    <%= ui_row_edit_button(edit_subscription_path(subscription)) if current_user.admin? %>
    <% if subscription.discardable_by?(current_user) %>
      <%= ui_row_delete_button(subscription, title: "Annulla", confirm: "Annullando l'abbonamento annullerai anche i pagamenti collegati. Continuare?") %>
    <% end %>
  </div>
</li>

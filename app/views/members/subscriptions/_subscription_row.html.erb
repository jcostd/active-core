<%
  is_active = Date.current.between?(subscription.start_date, subscription.end_date)
  is_future = Date.current < subscription.start_date
  is_expired = Date.current > subscription.end_date
%>

<li class="list-row items-center hover:bg-base-200/50 transition-colors <%= 'opacity-60 grayscale' if is_expired %>">

  <%# -- Icona Stato -- %>
  <div>
    <div class="p-2 rounded-box <%= is_active ? 'bg-success/10 text-success' : (is_future ? 'bg-info/10 text-info' : 'bg-base-300 text-base-content/50') %>">
      <%= icon(is_active ? "check_circle" : (is_future ? "schedule" : "block")) %>
    </div>
  </div>

  <%# -- Dati Principali -- %>
  <div class="grow min-w-0 flex flex-col gap-0.5">
    <div class="font-bold text-sm flex items-center gap-2">
      <span class="truncate"><%= subscription.product.name %></span>
      <% if is_active %>
        <span class="badge badge-success badge-sm text-[9px] uppercase font-bold text-white border-none">Attivo</span>
      <% elsif is_future %>
        <span class="badge badge-info badge-sm text-[9px] uppercase font-bold border-none">Futuro</span>
      <% else %>
        <span class="badge badge-ghost badge-sm text-[9px] uppercase border-none">Scaduto</span>
      <% end %>
    </div>

    <div class="text-[11px] font-mono opacity-60 flex items-center gap-2">
      <span>Dal <%= format_date(subscription.start_date) %></span>
      <span>al <strong class="<%= 'text-primary' unless is_expired %>"><%= format_date(subscription.end_date) %></strong></span>
    </div>

    <% if subscription.sale %>
      <div class="text-[10px] opacity-40 hover:opacity-100 transition-opacity mt-0.5">
        <% if subscription.sale.receipt_code %>
          Rif: <%= link_to subscription.sale.receipt_code, [subscription.sale], class: "link link-hover" %>
        <% else %>
          Acquistato il <%= format_date(subscription.sale.created_at) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# -- Giorni Rimasti -- %>
  <div class="text-right hidden sm:block w-20">
    <% if is_active %>
      <div class="text-xl font-black font-mono leading-none text-success">
        <%= (subscription.end_date - Date.current).to_i %>
      </div>
      <div class="text-[9px] uppercase font-bold tracking-wider opacity-50 mt-1">Rimasti</div>
    <% else %>
      <div class="text-xs font-mono opacity-50"><%= (subscription.end_date - subscription.start_date).to_i %> gg</div>
    <% end %>
  </div>

  <%# -- Azioni -- %>
  <div class="shrink-0 flex items-center gap-1 pl-2">
    <%= link_to [:edit, subscription], class: "btn btn-square btn-xs btn-ghost", data: { turbo_frame: "modal" }, title: "Modifica" do %>
      <%= icon("edit") %>
    <% end %>

    <% if subscription.end_date >= 7.days.ago.to_date %>
      <%= link_to [subscription],
		  class: "btn btn-square btn-xs btn-ghost text-error hover:bg-error/20",
		  data: {
		    turbo_method: :delete,
		    turbo_confirm: "Eliminando l'abbonamento annullerai l'incasso. Continuare?"
		  }, title: "Archivia" do %>
        <%= icon("delete") %>
      <% end %>
    <% end %>
  </div>
</li>

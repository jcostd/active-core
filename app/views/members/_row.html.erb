<%# locals: (member:) %>
<%= render layout: "shared/row", locals: { record: member, title: member.full_name, figure: ui_avatar(member, size: "size-10", text_size: "text-md"),
                                           edit_path: edit_member_path(member), archive_confirm: ("Archiviare #{member.full_name}?" if current_user.admin?) } do %>
  <div class="text-[11px] uppercase font-semibold opacity-70 flex flex-wrap items-center gap-1.5">
    <span><%= member.fiscal_code || "CF da completare" %></span> <%= member_status_badges(member) %>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render(partial: "subscriptions/compact", collection: member.relevant_subscriptions, as: :subscription) || member_empty_subscriptions_badge %>
  </div>
<% end %>

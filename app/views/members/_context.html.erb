<% content_for :member_tabs, record_tabs(member.full_name,
  [ "Panoramica", member_path(member), "badge" ],
  [ "Abbonamenti", member_subscriptions_path(member), "card_membership" ],
  ([ "Storico Acquisti", member_sales_path(member), "receipt" ] if current_user.admin?),
  [ "Presenze", member_attendances_path(member), "history" ]) %>

<%= render layout: "shared/record_header", locals: { title: member.full_name, avatar: ui_avatar(member),
                                                     badges: (ui_badge("Archiviato", tone: :error) if member.discarded?) } do %>
  <%= header_button "Vendi / Rinnova", new_sale_path(member_id: member.id), "shopping_cart", tone: "btn-primary", data: { turbo_frame: "modal" } %>
  <%= header_button "Modifica", edit_member_path(member), "edit", data: { turbo_frame: "modal" } %>
  <%= header_archive_button "Archivia", member_path(member), confirm: "Archiviare #{member.full_name}?" if current_user.admin? %>
<% end %>

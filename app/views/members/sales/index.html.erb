<%= turbo_stream_from @member, "sales" %>
<%= render "members/context", member: @member %>

<div class="flex justify-between items-center gap-4 mb-6 mt-6">
  <h2 class="text-xl font-bold flex items-center gap-2">
    <%= icon("receipt", classes: "size-6 opacity-50") %> Storico Acquisti
  </h2>

  <div class="text-right">
    <div class="text-xs uppercase tracking-widest opacity-60">
      Totale speso
    </div>
    <div class="text-lg font-semibold text-primary">
      <%= format_cents(@member.sales.kept.sum(:amount_cents) || 0) %>
    </div>
  </div>
</div>

<%# --- FORM DI RICERCA E FILTRI --- %>
<%= form_with url: member_sales_path(@member),
              method: :get,
              html: {
                autocomplete: "off",
                id: "filter-form",
                data: {
                  controller: "autosubmit drawer",
                  turbo_frame: "member_sales_list",
                  turbo_action: "advance"
                }
              } do |form| %>

  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 w-full mb-2">

    <div class="flex items-center gap-2 w-full md:w-1/2">
      <label class="input w-full">
        <%= icon("search", classes: "size-5 opacity-50") %>
        <%= form.search_field :query,
         value: params[:query],
         placeholder: "Cerca prodotto, codice ricevuta...",
         class: "grow",
         data: { action: "input->autosubmit#submit" } %>
      </label>

      <button type="button" data-action="drawer#open" class="btn bg-base-100 gap-2 shrink-0">
        <%= icon("filter") %>
        <span class="hidden sm:inline">Filtri</span>
      </button>
    </div>

    <%# DESTRA: Ordinamento (Usa il tuo partial condiviso) %>
    <div class="w-full md:w-auto shrink-0">
      <%= render "shared/filter/sort", form: form, sort_options: [
        ["Più recenti", "created_desc"],
        ["Meno recenti", "created_asc"],
        ["Prodotto (A-Z)", "name_asc"],
        ["Prodotto (Z-A)", "name_desc"]
      ] %>
    </div>
  </div>

  <%# IL CASSETTO DEI FILTRI %>
  <%= render "shared/filter/drawer", title: "Filtri Acquisti" do %>
    <div class="space-y-6">
      <fieldset>
        <label class="label font-bold text-sm">Prodotto</label>
        <%= form.select :product_id, grouped_product_options,
            { include_blank: "Tutti i prodotti", selected: params[:product_id] },
         { class: "select w-full", data: { action: "change->autosubmit#submit" } } %>
      </fieldset>

      <fieldset>
        <label class="label font-bold text-sm">Metodo di Pagamento</label>
        <%= form.select :payment_method, payment_method_options,
		 { include_blank: "Tutti i metodi", selected: params[:payment_method] },
         { class: "select w-full", data: { action: "change->autosubmit#submit" } } %>
      </fieldset>

      <fieldset>
        <label class="label font-bold text-sm">Stato in Archivio</label>
        <%= form.select :state, state_filters,
		 { include_blank: "Mostra solo Attivi", selected: params[:state] },
         { class: "select w-full", data: { action: "change->autosubmit#submit" } } %>
      </fieldset>
    </div>
  <% end %>
<% end %>

<%= turbo_frame_tag "member_sales_list" do %>
  <%= render "shared/filter/active", filter_keys: [:product_id, :payment_method, :state] %>

  <div class="mt-6">
    <% if @sales.empty? %>
      <%= render "shared/empty_state",
                 icon_name: "search_off",
                 title: "Nessun acquisto trovato",
                 message: "Prova a cambiare i criteri di ricerca o rimuovere i filtri." %>
    <% else %>

      <%= filtered_results_counter(@pagy) %>

      <ul class="list bg-base-100 shadow-sm border border-base-200 rounded-box w-full">
        <%= render partial: "members/sales/row", collection: @sales, as: :sale, cached: true %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>
<% end %>

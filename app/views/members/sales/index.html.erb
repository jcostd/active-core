<%= turbo_stream_from @member, "sales" %>
<%= render "members/context", member: @member %>

<%= render "shared/section_header", title: "Storico acquisti", icon_name: "receipt",
           aside: tag.div(safe_join([ tag.div("Totale speso", class: "text-xs uppercase opacity-60"), tag.div(format_cents(@total_amount_cents), class: "text-lg font-semibold text-primary") ]), class: "text-right") %>

<%= render layout: "shared/filter/form",
           locals: { url: member_sales_path(@member), frame: "member_sales_list", placeholder: "Cerca prodotto, codice ricevuta...",
                     drawer_title: "Filtri Acquisti",
                     sort_options: [ [ "Più recenti", "created_desc" ], [ "Meno recenti", "created_asc" ], [ "Prodotto (A-Z)", "name_asc" ], [ "Prodotto (Z-A)", "name_desc" ] ] } do %>
  <%= filter_select :product_id, grouped_product_options, label: "Prodotto", blank: "Tutti i prodotti" %>
  <%= filter_select :payment_method, payment_method_options, label: "Metodo di Pagamento", blank: "Tutti i metodi" %>
  <%= filter_select :state, state_filters, label: "Stato in Archivio", blank: "Mostra solo Attivi" %>
<% end %>

<%= render layout: "shared/list", locals: { frame: "member_sales_list", records: @sales, icon_name: "receipt", empty: "Nessun acquisto trovato",
                                            filter_keys: %i[product_id payment_method state] } do %>
  <ul class="list panel">
    <%= render partial: "members/sales/row", collection: @sales, as: :sale, cached: ->(sale) { [ sale, sale.reversible_by?(current_user) ] } %>
  </ul>
<% end %>

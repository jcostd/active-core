<%= turbo_stream_from @member %>
<%= render "members/context", member: @member %>

<div class="flex justify-between items-end mb-6 mt-6">
  <h2 class="text-xl font-bold flex items-center gap-2">
    <%= icon("receipt", classes: "size-5 opacity-50") %> Storico Acquisti
  </h2>

  <div class="text-right">
    <div class="stat-value text-primary text-2xl leading-none">
      <%= format_cents(@sales.sum(&:amount_cents) || 0) %>
    </div>
    <div class="text-xs font-bold uppercase tracking-wider opacity-50 mt-1">Totale speso</div>
  </div>
</div>

<ul class="list bg-base-100 shadow-sm border border-base-200 rounded-box w-full">
  <% if @sales.any? %>
    <%= render partial: "sale_row", collection: @sales, as: :sale %>
  <% else %>
    <li class="p-10 text-center opacity-50 text-sm italic">Nessun acquisto registrato.</li>
  <% end %>
</ul>

<% if @pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>

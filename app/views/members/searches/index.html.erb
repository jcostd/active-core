<turbo-frame id="<%= params[:frame_id] || "member_search_results" %>">
  <% if @members.any? %>
    <ul class="menu flex-nowrap bg-base-100 w-full shadow-xl rounded-box border border-base-300 absolute z-50 mt-1 max-h-72 overflow-y-auto">
      <% @members.each do |member| %>
        <li>
          <button type="button" class="flex flex-col items-start gap-1"
                  data-action="autocomplete#select" data-id="<%= member.id %>" data-name="<%= member.full_name %>">
            <span class="font-bold truncate w-full"><%= member.full_name %></span>
            <span class="text-xs opacity-60 font-mono">
              CF: <%= display_value(member.fiscal_code, placeholder: "da completare") %> · nato il <%= format_date(member.birth_date) %>
            </span>
          </button>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="bg-base-100 shadow-xl rounded-box border border-base-300 absolute z-50 mt-1 w-full p-4 text-sm opacity-60 italic text-center">
      Nessun socio trovato con questa ricerca.
    </p>
  <% end %>
</turbo-frame>

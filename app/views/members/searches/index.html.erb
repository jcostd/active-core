<turbo-frame id="<%= params[:frame_id] || 'member_search_results' %>">
  <% if @members.any? %>
    <ul class="list bg-base-100 w-full shadow-2xl rounded-box border border-base-300 absolute z-50 mt-1 max-h-72 overflow-y-auto">

      <% @members.each do |member| %>
        <li class="list-row p-0 text-left flex flex-col justify-center gap-1.5 px-4 py-3 hover:bg-base-200/60 transition-colors"
	    data-action="click->autocomplete#select"
            data-id="<%= member.id %>"
            data-name="<%= member.full_name %>">


            <div class="font-bold text-base leading-none text-base-content truncate w-full">
              <%= member.full_name %>
            </div>

            <div class="text-xs opacity-60 w-full truncate font-mono">
              CF: <%= member.fiscal_code.presence || "N/A" %>
	      <span class="opacity-40 mx-1">•</span>
              BIRTH: <%= format_date(member.birth_date).presence || "N/A" %>
            </div>
        </li>
      <% end %>

    </ul>
  <% else %>
    <div class="p-4 bg-base-100 shadow-2xl rounded-box border border-base-300 absolute z-50 mt-1 w-full text-sm opacity-60 italic text-center">
      Nessun socio trovato con questa ricerca.
    </div>
  <% end %>
</turbo-frame>

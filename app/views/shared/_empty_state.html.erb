<div class="flex flex-col items-center justify-center py-24 px-4 text-center bg-base-100/70 rounded-box border-2 border-dashed border-base-300/70">

  <%= icon(icon_name, classes: "size-16 text-base-content/20 mb-6") %>

  <h3 class="text-xl font-bold text-base-content tracking-tight">
    <%= title %>
  </h3>

  <p class="mt-2 text-sm text-base-content/50 max-w-sm leading-relaxed">
    <%= message %>
  </p>

  <% if block_given? %>
    <div class="mt-8 flex items-center justify-center gap-3">
      <%= yield %>
    </div>
  <% end %>

</div>

<dialog
  data-drawer-target="dialog"
  data-action="click->drawer#clickOutside"
  class="backdrop:bg-neutral/50 p-0 m-0 fixed right-0 left-auto h-full max-h-screen w-80 sm:w-96 shadow-2xl transition-transform duration-300 open:translate-x-0 translate-x-full bg-base-100"
>
  <div class="flex flex-col h-full w-full">

    <%# Header del cassetto %>
    <div class="flex items-center justify-between border-b border-base-200 p-4">
      <h3 class="font-bold text-xl flex items-center gap-2">
        <%= icon("filter", size: 20, class: "opacity-70") %>
        <%= title %>
      </h3>
      <button type="button" class="btn btn-sm btn-square btn-ghost" data-action="drawer#close">
        <%= icon("close", classes: "size-4") %>
      </button>
    </div>

    <%# Corpo dei filtri %>
    <div class="flex-1 overflow-y-auto p-4 space-y-6">
      <%= yield %>
    </div>

  </div>
</dialog>

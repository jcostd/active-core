<%# pannello laterale: modal-end di daisyUI; niente <form method="dialog"> perché sta dentro il form dei filtri %>
<dialog id="filter_drawer" data-drawer-target="dialog" class="modal modal-end"
        data-action="close->drawer#closed turbo:before-cache@document->drawer#close">
  <div class="modal-box h-full max-h-screen w-80 sm:w-96 rounded-none p-0 flex flex-col">
    <div class="flex items-center justify-between border-b border-base-200 p-4">
      <h3 class="font-bold text-xl flex items-center gap-2">
        <%= icon("filter", classes: "size-5 opacity-70") %>
        <%= title %>
      </h3>
      <button type="button" class="btn btn-sm btn-square btn-ghost" aria-label="Chiudi" data-action="drawer#close">
        <%= icon("close", classes: "size-4") %>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto p-4 space-y-6">
      <%= yield %>
    </div>
  </div>

  <div class="modal-backdrop" data-action="click->drawer#close"></div>
</dialog>

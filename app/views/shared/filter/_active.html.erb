<%# locals: (filter_keys: []) %>
<%# chip dei filtri attivi: ognuno è un link alla stessa pagina senza quel filtro, niente JavaScript %>
<% active = active_filters.slice(*filter_keys.map(&:to_s)) %>
<% if active.any? %>
  <div id="active_filters" class="flex flex-wrap items-center gap-2">
    <% active.each do |key, value| %>
      <span class="badge badge-neutral gap-1 pl-2 pr-1 py-3 shadow-sm">
        <span class="text-[0.65rem] uppercase tracking-wider opacity-60 font-semibold"><%= humanize_filter_key(key) %>:</span>
        <strong class="text-sm font-bold truncate max-w-[150px]"><%= humanize_filter_value(key, value) %></strong>
        <%= link_to icon("close", classes: "size-3.5"), current_path_with(request.query_parameters.except(key, "page")),
                    class: "btn btn-ghost btn-xs btn-circle", aria: { label: "Rimuovi filtro #{humanize_filter_key(key)}" }, data: { turbo_frame: "_top" } %>
      </span>
    <% end %>
    <%= link_to "Azzera filtri", current_path_with(request.query_parameters.slice("sort", "month")),
                class: "text-xs font-semibold text-base-content/50 hover:text-error ml-2", data: { turbo_frame: "_top" } %>
  </div>
<% end %>

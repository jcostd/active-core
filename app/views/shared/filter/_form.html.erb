<%# locals: (url:, frame:, placeholder:, drawer_title: nil, sort_options: nil, default_sort: nil) %>
<%# ricerca + ordinamento + cassetto filtri; il blocco (facoltativo) riceve il form e aggiunge i campi del cassetto %>
<% drawer = drawer_title.present? %>
<%= form_with url:, method: :get,
              html: { autocomplete: "off", id: "filter-form",
                      data: { controller: "autosubmit drawer", turbo_frame: frame, turbo_action: "advance" } } do |form| %>
  <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-2">
    <div class="flex items-center gap-2 w-full md:w-1/2">
      <label class="input w-full">
        <%= icon("search", classes: "size-5 opacity-50") %>
        <%= form.search_field :query, value: params[:query], placeholder:, class: "grow",
                              data: { action: "input->autosubmit#submit" } %>
      </label>

      <% if drawer %>
        <button type="button" class="btn bg-base-100 gap-2 shrink-0" data-action="drawer#open">
          <%= icon("filter") %>
          <span class="hidden sm:inline">Filtri</span>
        </button>
      <% end %>
    </div>

    <%= render "shared/filter/sort", form:, **{ sort_options:, default_sort: }.compact %>
  </div>

  <% if drawer %>
    <%= render "shared/filter/drawer", title: drawer_title do %>
      <%= yield form %>
    <% end %>
  <% end %>
<% end %>

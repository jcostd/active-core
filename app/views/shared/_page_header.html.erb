<%# locals: (title:, counter: nil, new_path: nil, new_label: "Nuovo") %>
<% content_for :title, title %>
<header class="flex items-start justify-between gap-3 pb-4">
  <div>
    <h1 class="text-2xl sm:text-3xl font-bold leading-tight"><%= title %></h1>
    <% if counter %>
      <span class="text-sm text-base-content/60 font-mono tabular-nums"><%= counter %></span>
    <% end %>
  </div>
  <% if new_path %>
    <%= link_to new_path, class: "btn btn-primary", data: { turbo_frame: "modal" } do %>
      <%= icon("add") %> <span class="hidden sm:inline"><%= new_label %></span>
    <% end %>
  <% end %>
</header>

<div class="sticky top-0 z-30 flex h-16 w-full bg-base-200 justify-center print:hidden">

  <nav class="navbar w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-0">

    <div class="flex flex-1 items-center gap-2">
      <div class="tooltip tooltip-bottom before:text-xs" data-tip="Menu">
        <label aria-label="Open menu" for="main-drawer" class="btn btn-square btn-ghost drawer-button lg:hidden">
          <%= icon("menu") %>
        </label>
      </div>
    </div>


    <div class="flex items-center gap-1">
      <%= render "shared/navbar/theme_dropdown" %>
      <%#= render "shared/navbar/language_dropdown" %>
      <%= render "shared/navbar/user_dropdown" %>
    </div>

  </nav>
</div>

<div class="toast toast-bottom toast-end z-[100] pb-8 pr-8">
  <% flash.each do |type, message| %>
    <% next if type.to_s == 'timedout' %>

    <div
      class="alert <%= flash_class(type) %> shadow-lg mb-2 flex flex-row
	     items-center gap-2 transform transition-all duration-300 min-w-[300px]"
      data-controller="flash"
    >
      <%= icon(flash_icon_name(type)) %>
      <span class="flex-1 text-sm font-medium"><%= message %></span>
      <button
        class="btn btn-square btn-xs btn-ghost"
        data-action="click->flash#dismiss"
      >
        <%= icon("close") %>
      </button>
    </div>
  <% end %>
</div>

<%= render layout: "shared/dropdown_layout", locals: {
  group_name: "navbar_dropdowns",
  title: "Cambia Tema",
  icon_name: "theme",
  menu_class: "menu flex flex-col flex-nowrap dropdown-content bg-base-100 rounded-box shadow-lg mt-4 w-52 max-h-[60vh] overflow-y-auto p-2"
} do %>

  <li class="menu-title">Temi</li>

  <% UserPreferences::THEMES.each do |theme| %>
    <% is_active = current_user&.preferences&.dig("theme") == theme %>

    <li class="w-full">
      <%= link_to preferences_theme_path(theme: theme),
		  data: { turbo_method: :patch },
		  class: "capitalize flex w-full justify-between #{'active' if is_active}" do %>

        <%= theme %>

        <% if is_active %>
          <%= icon("check") %>
        <% end %>
      <% end %>
    </li>
  <% end %>

<% end %>

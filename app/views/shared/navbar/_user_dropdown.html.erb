<%= render layout: "shared/dropdown_layout", locals: {
  group_name: "navbar_dropdowns",
  title: "Menu Utente",
  summary_class: "btn-sm btn-ghost gap-2 px-2",
  icon_name: "account_circle",
  summary_text: current_user&.username,
  menu_class: "menu dropdown-content bg-base-100 rounded-box shadow-lg mt-4 w-60 p-2 gap-1"
} do %>

  <li class="menu-title flex flex-col items-start gap-0.5 mb-2">
    <span class="text-[0.65rem] uppercase tracking-wider"><%= User.human_attribute_name(:role) %></span>
    <span class="font-semibold text-sm text-base-content"><%= current_user&.role&.humanize %></span>
  </li>

  <li>
    <%= link_to user_path(current_user), class: "flex items-center gap-3" do %>
      <%= icon("user", classes: "size-5 opacity-70") %>
      <%= t("navbar.my_profile", default: "Il mio profilo") %>
    <% end %>
  </li>

  <li>
    <%# Tasto Esci: sfruttiamo i colori semantici nativi hover:bg-error %>
    <%= link_to session_path,
		class: "flex items-center gap-3 text-error hover:bg-error hover:text-error-content",
		data: { turbo_method: :delete } do %>
      <%= icon("logout") %>
      <%= t("navbar.logout", default: "Esci") %>
    <% end %>
  </li>

<% end %>

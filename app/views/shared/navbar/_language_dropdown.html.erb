<%= render layout: "shared/dropdown_layout", locals: {
  group_name: "navbar_dropdowns",
  title: "Cambia Lingua",
  icon_name: "language",
  menu_class: "menu flex flex-col flex-nowrap dropdown-content bg-base-100 rounded-box shadow-lg mt-4 w-56 p-2"
} do %>

  <% I18n.available_locales.each do |locale| %>
    <% is_active = current_user.try(:locale_or_default).to_s == locale.to_s %>

    <li class="w-full">
      <%= link_to preferences_language_path(language: locale), data: { turbo_method: :patch }, class: "flex w-full justify-between #{'active' if is_active}" do %>

        <div class="flex items-center gap-2">
          <span class="font-mono text-[0.65rem] font-bold opacity-50 w-6 text-center">
            <%= locale.to_s.upcase %>
          </span>
          <span><%= I18n.t("language_name", locale: locale, default: locale.to_s.upcase) %></span>
        </div>

        <% if is_active %>
          <%= icon("check", size: 16) %>
        <% end %>

      <% end %>
    </li>
  <% end %>

<% end %>

<header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-base-200">

  <div class="flex items-center gap-4 w-full sm:w-auto">

    <%= link_to :back, class: "btn btn-square btn-ghost btn-sm shrink-0", title: "Indietro" do %>
      <%= icon("arrow_left", size: 20) %>
    <% end %>

    <% if content_for?(:record_avatar) %>
      <div class="shrink-0">
        <%= yield :record_avatar %>
      </div>
    <% end %>

    <div class="grow min-w-0">
      <h1 class="text-2xl sm:text-3xl font-bold leading-none mb-1.5 truncate">
        <%= yield :record_title %>
      </h1>

      <% if content_for?(:record_subtitle) || content_for?(:record_status_badges) %>
        <div class="flex flex-wrap items-center gap-2">
          <%= yield :record_subtitle %>
          <%= yield :record_status_badges %>
        </div>
      <% end %>
    </div>
  </div>

  <% if content_for?(:record_actions) %>
    <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
      <%= yield :record_actions %>
    </div>
  <% end %>

</header>

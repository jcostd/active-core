<header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-base-200">

  <%# --- 1. BLOCCO IDENTITÀ (Back + Avatar + Testi) --- %>
  <div class="flex items-center gap-4 w-full sm:w-auto">

    <%# Pulsante Indietro %>
    <%= link_to :back, class: "btn btn-square btn-ghost btn-sm shrink-0", title: t("actions.back", default: "Indietro") do %>
      <%= icon("arrow_left", size: 20) %>
    <% end %>

    <%# Avatar (Singolo, senza duplicazioni mobile/desktop) %>
    <% if content_for?(:record_avatar) %>
      <div class="shrink-0">
        <%= yield :record_avatar %>
      </div>
    <% end %>

    <%# Titolo, Sottotitolo e Badge %>
    <div class="grow min-w-0">
      <h1 class="text-2xl sm:text-3xl font-bold leading-none mb-1.5 truncate">
        <%= yield :record_title %>
      </h1>

      <%# Uniamo Subtitle e Status Badges in un'unica riga pulita e avvolgente (flex-wrap) %>
      <% if content_for?(:record_subtitle) || content_for?(:record_status_badges) %>
        <div class="flex flex-wrap items-center gap-2">
          <%= yield :record_subtitle %>
          <%= yield :record_status_badges %>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- 2. BLOCCO AZIONI --- %>
  <% if content_for?(:record_actions) %>
    <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
      <%= yield :record_actions %>
    </div>
  <% end %>

</header>

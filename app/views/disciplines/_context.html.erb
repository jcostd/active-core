<% content_for :discipline_tabs, record_tabs(discipline.name,
  [ "Panoramica", discipline_path(discipline), "badge" ],
  [ "Iscritti", discipline_members_path(discipline), "group" ]) %>

<%= render layout: "shared/record_header", locals: { title: discipline.name, avatar: icon("category", classes: "size-14 opacity-50"),
                                                     badges: (ui_badge("Archiviata", tone: :error) if discipline.discarded?) } do %>
  <% if current_user.admin? %>
    <%= header_button "Modifica", edit_discipline_path(discipline), "edit", data: { turbo_frame: "modal" } %>
    <%= header_archive_button "Archivia", discipline_path(discipline), confirm: "Archiviare la disciplina #{discipline.name}?" %>
  <% end %>
<% end %>

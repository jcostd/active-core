<%# locals: (discipline:) %>
<%= render layout: "shared/row", locals: { record: discipline, title: discipline.name, figure: row_icon("category"),
                                           edit_path: (edit_discipline_path(discipline) if current_user.admin?),
                                           archive_confirm: ("Archiviare #{discipline.name}?" if current_user.admin?) } do %>
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-[11px] uppercase font-semibold opacity-70"><%= pluralize(discipline.products.size, "prodotto", plural: "prodotti") %></span>
    <%= ui_requirement_badge(discipline.requires_medical_certificate?, text: "Cert. Medico", icon_name: "med", active_class: "badge-error badge-soft") %>
    <%= ui_requirement_badge(discipline.requires_membership?, text: "Iscrizione", icon_name: "card_membership") %>
  </div>
<% end %>

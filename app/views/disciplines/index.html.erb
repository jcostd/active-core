<%= turbo_stream_from "disciplines" %>
<%= render "shared/page_header", title: "Discipline", counter: "#{Discipline.kept.count} totali", new_path: (new_discipline_path if current_user.admin?), new_label: "Nuova" %>

<%= render "shared/filter/form", url: disciplines_path, frame: "disciplines_list", placeholder: "Cerca disciplina..." %>

<%= render layout: "shared/list", locals: { frame: "disciplines_list", records: @disciplines, icon_name: "category", empty: "Nessuna disciplina trovata" } do %>
  <ul id="disciplines" class="list panel">
    <%= render partial: "disciplines/row", collection: @disciplines, as: :discipline %>
  </ul>
<% end %>

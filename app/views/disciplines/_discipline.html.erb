<%# locals: (discipline:) %>

<div id="<%= dom_id(discipline) %>" class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">

  <%# ========================================== %>
  <%# COLONNA SINISTRA: REGOLE E ACCESSI %>
  <%# ========================================== %>
  <div class="space-y-6">
    <div class="card bg-base-100 shadow-sm border border-base-200">
      <div class="card-body p-4">
        <h3 class="text-xs font-bold uppercase opacity-50 tracking-wider mb-3 flex items-center gap-2">
          <%= icon("settings", classes: "size-4") %> Configurazione Accesso
        </h3>

        <ul class="space-y-4 text-sm mt-2">
          <li class="flex gap-4 items-center">
            <div class="p-2.5 rounded-box <%= discipline.requires_medical_certificate? ? 'bg-error/10 text-error' : 'bg-base-200 text-base-content/30' %>">
              <%= icon("med", classes: "size-5") %>
            </div>
            <div>
              <div class="font-bold">Certificato Medico</div>
              <div class="text-xs opacity-70">
                <%= discipline.requires_medical_certificate? ? "<span class='text-error font-medium'>Richiesto per l'ingresso</span>".html_safe : "Non richiesto" %>
              </div>
            </div>
          </li>

          <li class="flex gap-4 items-center">
            <div class="p-2.5 rounded-box <%= discipline.requires_membership? ? 'bg-info/10 text-info' : 'bg-base-200 text-base-content/30' %>">
              <%= icon("card_membership", classes: "size-5") %>
            </div>
            <div>
              <div class="font-bold">Tesseramento</div>
              <div class="text-xs opacity-70">
                <%= discipline.requires_membership? ? "<span class='text-info font-medium'>Quota annuale obbligatoria</span>".html_safe : "Accesso libero" %>
              </div>
            </div>
          </li>
        </ul>

	<% if current_user.admin? %>
          <%= link_to "Modifica Regole", edit_discipline_path(discipline), class:
          "mt-2 btn btn-xs btn-outline w-full", data: { turbo_frame: "modal" } %>
	<% end %>
      </div>
    </div>
  </div>

  <%# ========================================== %>
  <%# COLONNA DESTRA: PRODOTTI COLLEGATI %>
  <%# ========================================== %>
  <div class="lg:col-span-2 space-y-6">
    <div class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
      <div class="p-4 bg-base-200/30 border-b border-base-200 flex justify-between items-center">
        <h3 class="font-bold text-sm uppercase opacity-70 tracking-wider flex items-center gap-2">
          <%= icon("category", classes: "size-4") %> Prodotti Collegati
        </h3>
        <span class="badge badge-sm badge-ghost"><%= display_value(@related_products&.count || discipline.products.count) %></span>
      </div>

      <% products = @related_products || discipline.products %>
      <% if products.any? %>
	<ul class="list bg-base-100 rounded-none w-full">
	  <% products.each do |product| %>
	    <li class="list-row items-center hover:bg-base-200/50 transition-colors group relative">

	      <%= link_to "", product_path(product), data: { turbo_frame: "_top" }, class: "absolute inset-0 z-10", aria: { label: "Vedi dettaglio #{display_value(product.name)}" } %>

	      <div>
		<div class="p-2 rounded-box bg-base-200 text-base-content/40 group-hover:text-primary transition-colors">
		  <%= icon("product") %>
		</div>
	      </div>

	      <div class="grow min-w-0">
		<div class="font-bold truncate group-hover:text-primary transition-colors">
		  <%= display_value(product.name) %>
		</div>
		<div class="text-xs opacity-70 flex items-center gap-2 mt-0.5">
		  <span class="badge badge-xs badge-ghost font-mono"><%= display_value(product.duration_days) %>gg</span>
		  <span><%= product.associative? ? "Istituzionale" : "Associativo" %></span>
		</div>
	      </div>

	      <div class="shrink-0 font-mono font-bold text-lg pr-2">
		<%= format_money(product.price) %>
	      </div>

	    </li>
	  <% end %>
	</ul>

      <% else %>
        <div class="text-center py-8">
          <div class="bg-base-200 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 opacity-50">
            <%= icon("info") %>
          </div>
          <h4 class="font-bold opacity-70 text-sm">Nessun prodotto collegato</h4>
          <div class="text-xs opacity-60 mt-1">Attualmente non è possibile vendere accessi per questa disciplina.</div>

          <% if current_user&.admin? %>
            <div class="mt-4">
              <%= link_to "Crea Prodotto", new_product_path(discipline_id: discipline.id), class: "btn btn-primary btn-sm btn-outline", data: { turbo_frame: "modal" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

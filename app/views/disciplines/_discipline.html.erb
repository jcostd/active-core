<%# locals: (discipline:) %>
<% products = discipline.products.kept %>
<div id="<%= dom_id(discipline) %>" class="record-layout">
  <%= render layout: "shared/panel", locals: { title: "Regole", icon_name: "settings" } do %>
    <%= render "shared/details", rows: {
          "Certificato medico" => (discipline.requires_medical_certificate? ? tag.span("Richiesto", class: "text-error font-medium") : "Non richiesto"),
          "Quota associativa" => (discipline.requires_membership? ? tag.span("Obbligatoria", class: "text-info font-medium") : "Non richiesta") } %>
  <% end %>

  <div class="record-main">
    <%= render layout: "shared/panel", locals: { title: "Prodotti collegati", icon_name: "category",
                                                 aside: tag.span(products.size, class: "badge badge-sm badge-ghost") } do %>
      <% if products.any? %>
        <ul class="list">
          <% products.each do |product| %>
            <li class="list-row items-center">
              <%= icon("product", classes: "size-5 opacity-40") %>
              <div class="list-col-grow min-w-0">
                <%= link_to product.name, product, class: "font-bold link link-hover" %>
                <div class="text-xs opacity-70 flex items-center gap-2 mt-0.5">
                  <span class="font-mono"><%= display_value(product.duration_days) %> gg</span> <%= product_category_badge(product) %>
                </div>
              </div>
              <span class="font-mono font-bold text-lg"><%= format_money(product.price) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", compact: true, icon_name: "info", title: "Nessun prodotto collegato",
                   message: "Finché non c'è un prodotto, per questa disciplina non si vende nulla.",
                   action: (link_to("Crea prodotto", new_product_path(discipline_id: discipline.id), class: "btn btn-primary btn-sm btn-outline",
                                    data: { turbo_frame: "modal" }) if current_user.admin?) %>
      <% end %>
    <% end %>
  </div>
</div>

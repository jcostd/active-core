<%# locals: (member:, discipline:, month:, editable:, enrollments:, attendance:) %>
<li id="<%= dom_id(member) %>" class="list-row hover:bg-base-200/50 transition-colors">
  <div class="shrink-0 self-start sm:self-center">
    <%= ui_avatar(member, size: "size-10", text_size: "text-md") %>
  </div>

  <div class="flex flex-col gap-1 min-w-0 grow">
    <div class="font-bold truncate text-base leading-none">
      <%= link_to member.full_name, member, data: { turbo_frame: "_top" }, class: "hover:text-primary transition-colors" %>
    </div>

    <div class="text-[11px] uppercase font-semibold opacity-70 flex flex-wrap items-center gap-1.5">
      <%= member_status_badges(member) %>
    </div>

    <div class="flex flex-wrap items-center gap-2 mt-0.5">
      <%= render partial: "subscriptions/compact", collection: enrollments, as: :subscription %>
    </div>
  </div>

  <div class="flex items-center gap-2 shrink-0 self-start sm:self-center">
    <% if attendance %>
      <span class="badge badge-sm badge-soft badge-success gap-1 font-bold" title="Segnato da <%= attendance.marked_by.full_name %>">
        <%= icon("check", classes: "size-3") %> Visto
      </span>
      <% if editable %>
        <%= button_to discipline_attendance_path(discipline, attendance), method: :delete,
                      class: "btn btn-square btn-ghost btn-sm text-base-content/50 hover:text-error", title: "Togli dal registro",
                      form: { data: { turbo_confirm: "Togliere #{member.full_name} dal registro di #{l(month, format: "%B %Y")}?", turbo_frame: "_top" } } do %>
          <%= icon("close", classes: "size-4") %>
        <% end %>
      <% end %>
    <% elsif editable %>
      <%= button_to "Segna visto", discipline_attendances_path(discipline), params: { member_id: member.id, month: month.strftime("%Y-%m") },
                    class: "btn btn-sm btn-ghost", form: { data: { turbo_frame: "_top" } } %>
    <% else %>
      <span class="badge badge-sm badge-ghost opacity-60">Non visto</span>
    <% end %>
  </div>
</li>

<% member = subscription.member %>
<% is_expired = subscription.expired? %>
<% days_diff = (subscription.end_date - Date.current).to_i.abs %>

<li id="<%= dom_id(subscription) %>" class="list-row group hover:bg-base-200/50 transition-colors">

  <%# -- Colonna 1: Avatar -- %>
  <div class="shrink-0 self-start sm:self-center mt-1 sm:mt-0">
    <%= ui_avatar(member, size: "size-10", text_size: "text-md") %>
  </div>

  <%# -- Colonna 2: Contenuto centrale (Anagrafica & Prodotto) -- %>
  <div class="flex flex-col gap-1 min-w-0 grow">

    <%# Nome e Status Dot %>
    <div class="font-bold truncate text-base leading-none flex items-center gap-2">
      <%= link_to display_value(member.full_name), member_path(member),
      data: { turbo_frame: "_top" },
                  class: "hover:text-primary transition-colors focus:outline-none" %>

      <div class="size-2 rounded-full shrink-0 <%= is_expired ? 'bg-error animate-pulse' : 'bg-success' %>"
           title="<%= is_expired ? 'Scaduto' : 'Attivo' %>"></div>
    </div>

    <%# CF e Nome Prodotto %>
    <div class="text-[11px] uppercase font-semibold opacity-70 flex flex-wrap items-center gap-1.5 mt-0.5">
      <span class="font-mono"><%= display_value(member.fiscal_code) %></span>

      <% if subscription.product.present? %>
        <span class="font-bold">&bull; <%= display_value(subscription.product.name) %></span>
      <% end %>
    </div>
  </div>

  <%# -- Colonna 3: Scadenza -- %>
  <div class="flex flex-col items-end shrink-0 self-start sm:self-center text-right min-w-[5rem]">
    <span class="text-sm font-mono tabular-nums <%= is_expired ? 'text-error font-bold' : 'font-medium' %>">
      <%= format_date(subscription.end_date) %>
    </span>
    <span class="text-[10px] uppercase tracking-wider font-semibold mt-0.5 <%= is_expired ? 'text-error' : 'opacity-60' %>">
      <%= is_expired ? "Scaduto da #{days_diff}g" : "Scade tra #{days_diff}g" %>
    </span>
  </div>

  <%# -- Colonna 4: Azione Rapida (Rinnovo) -- %>
  <div class="flex items-center gap-1 shrink-0 self-start sm:self-center min-w-[2rem] justify-end pl-2">
    <%= link_to new_sale_path(member_id: member.id, renew_subscription_id: subscription.id),
                class: "btn btn-sm btn-square btn-ghost opacity-60 hover:opacity-100 hover:text-primary hover:bg-primary/10 transition-all",
                data: { turbo_frame: "modal" },
                title: "Rinnova Abbonamento" do %>
      <%= icon("reset", classes: "size-5") %>
    <% end %>
  </div>

</li>

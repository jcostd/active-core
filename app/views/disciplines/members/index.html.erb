<%= render "disciplines/context", discipline: @discipline %>

<div class="items-center mb-6 mt-6">
  <h2 class="text-xl font-bold flex items-center gap-2">
    <%= icon("group", classes: "size-6 opacity-50") %> Registro Iscritti
  </h2>
</div>

<%# --- FORM DI RICERCA E FILTRI --- %>
<%= render layout: "shared/filter/form",
           locals: { url: discipline_members_path(@discipline), frame: "discipline_members_list", placeholder: "Cerca iscritto...",
                     drawer_title: "Filtri Iscritti", default_sort: "recent",
                     sort_options: [ [ "Scadenza: Imminenti", "expiring_asc" ], [ "Scadenza: Lontane", "expiring_desc" ], [ "Più recenti", "recent" ] ] } do |form| %>
  <%= filter_select form, :product_id, @products.pluck(:name, :id), label: "Corso", blank: "Tutti i Corsi" %>
  <%= filter_select form, :state, [ [ "Attive", "active" ], [ "Scadute", "expired" ], [ "Future", "upcoming" ] ], label: "Stato Iscrizione al Corso", blank: "Tutti gli stati" %>
  <%= filter_select form, :membership_status, member_membership_filters, label: "Tesseramento", blank: "Qualsiasi" %>
  <%= filter_select form, :med_cert, member_med_cert_filters, label: "Certificato Medico", blank: "Qualsiasi" %>
<% end %>

<%= turbo_frame_tag "discipline_members_list" do %>
  <%= render "shared/filter/active", filter_keys: [:product_id, :sort, :state, :membership_status, :med_cert] %>

  <div class="mt-6">
    <% if @pagy.count == 0 %>
      <%= render "shared/empty_state",
                 icon_name: "filter_off",
                 title: "Nessun socio trovato",
                 message: "Prova a cambiare i criteri di ricerca o rimuovere i filtri." %>
    <% else %>

      <%= filtered_results_counter(@pagy) %>

      <ul id="subscriptions" class="list bg-base-100 shadow-sm border border-base-200 rounded-box w-full">
        <%= render partial: "disciplines/members/row", collection: @subscriptions, as: :subscription %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>
<% end %>

<%= turbo_stream_from @discipline, :attendances %>
<%= turbo_stream_from "members" %>
<%= render "disciplines/context", discipline: @discipline %>

<%= render "shared/section_header", title: "Iscritti di #{l(@month, format: "%B %Y")}", icon_name: "group",
                                    aside: render("shared/month_nav", month: @month) %>

<%= render layout: "shared/filter/form",
           locals: { url: discipline_members_path(@discipline), frame: "discipline_members_list", placeholder: "Cerca iscritto...",
                     drawer_title: "Filtri Iscritti", default_sort: "name_asc",
                     sort_options: [ [ "Nome: A-Z", "name_asc" ], [ "Nome: Z-A", "name_desc" ] ] } do %>
  <%= hidden_field_tag :month, params[:month] %>
  <%= filter_select :product_id, @products.pluck(:name, :id), label: "Prodotto", blank: "Tutti i prodotti" %>
  <%= filter_select :seen, [ [ "Visti dall'istruttore", "yes" ], [ "Non visti", "no" ] ], label: "Registro", blank: "Tutti" %>
  <%= filter_select :membership_status, member_membership_filters, label: "Tesseramento", blank: "Qualsiasi" %>
  <%= filter_select :med_cert, member_med_cert_filters, label: "Certificato Medico", blank: "Qualsiasi" %>
<% end %>

<%= turbo_frame_tag "discipline_members_list" do %>
  <%= render "shared/filter/active", filter_keys: [:product_id, :seen, :membership_status, :med_cert] %>

  <% if @unenrolled.any? %>
    <section id="unenrolled_attendances" class="mt-6 card bg-error/5 border border-error/30">
      <div class="card-body p-4 gap-3">
        <h3 class="font-bold flex items-center gap-2">
          <%= icon("warning", classes: "size-5 text-error") %> Frequentano senza abbonamento (<%= @unenrolled.size %>)
        </h3>
        <ul class="list">
          <%= render partial: "disciplines/attendances/unenrolled", collection: @unenrolled, as: :attendance,
                     locals: { editable: @editable, products_to_sell: @products_to_sell } %>
        </ul>
      </div>
    </section>
  <% end %>

  <div class="mt-6">
    <% if @pagy.count == 0 %>
      <%= render "shared/empty_state",
                 icon_name: "filter_off",
                 title: "Nessun iscritto",
                 message: "Nessun socio ha un abbonamento di questa disciplina in #{l(@month, format: "%B %Y")} con questi filtri." %>
    <% else %>
      <%= filtered_results_counter(@pagy) %>

      <ul id="discipline_members" class="list bg-base-100 shadow-sm border border-base-200 rounded-box w-full">
        <% @members.each do |member| %>
          <%= render "disciplines/members/row", member:, discipline: @discipline, month: @month, editable: @editable,
                                                enrollments: @enrollments.fetch(member), attendance: @attendances[member.id] %>
        <% end %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>
<% end %>

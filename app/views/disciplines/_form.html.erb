<%= form_with model: discipline, class: "flex flex-col gap-4" do |f| %>
  <%= render "shared/form_errors", model: discipline %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("fitness_center", classes: "size-4") %> Disciplina</legend>
    <%= f.label :name %>
    <%= f.text_field :name, required: true, placeholder: "Es. Sala Pesi, Yoga, Capoeira Bambini..." %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("shield", classes: "size-4") %> Per frequentarla serve</legend>
    <label class="label">
      <%= f.check_box :requires_medical_certificate, class: "toggle toggle-error" %> Il certificato medico valido
    </label>
    <label class="label">
      <%= f.check_box :requires_membership, class: "toggle toggle-info" %> La quota associativa dell'anno sportivo
    </label>
    <p class="label whitespace-normal">Il registro segna chiunque venga; la segreteria vede chi non è in regola.</p>
  </fieldset>

  <div class="modal-action"><%= f.submit %></div>
<% end %>

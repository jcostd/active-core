<li
  id="<%= dom_id(product) %>"
  class="list-row hover:bg-base-200/50 transition-colors <%= 'opacity-60 grayscale' if product.discarded? %>">

  <div class="shrink-0">
    <div class="size-10 bg-base-200/50 rounded-box flex items-center justify-center text-base-content/40">
      <%= icon("product") %>
    </div>
  </div>

  <div class="grid gap-1 min-w-0 grow">
    <div class="font-bold truncate text-base leading-none">
      <%= link_to product.name, product,
		  data: { turbo_frame: "_top" },
		  class: "hover:underline hover:text-primary transition-colors" %>
    </div>

    <div class="flex flex-wrap items-center gap-1 mt-0.5">
      <% if product.disciplines.any? %>
        <% product.disciplines.each do |d| %>
          <span class="badge badge-sm badge-ghost opacity-70"><%= d.name %></span>
        <% end %>
      <% else %>
        <span class="text-[10px] uppercase font-bold tracking-wider opacity-30 flex items-center gap-1">
          <span class="size-1.5 rounded-full bg-current"></span> Nessuna disciplina
        </span>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row items-end sm:items-center gap-2 sm:gap-6 shrink-0 mr-2">

    <%# Categoria %>
    <div class="text-xs font-medium">
      <%= product_category_badge(product) %>
    </div>

    <%# Durata %>
    <div class="font-mono text-sm opacity-60 tabular-nums">
      <%= display_value(product.duration_days) %> gg
    </div>

    <%# Prezzo %>
    <div class="font-mono font-bold text-lg tabular-nums text-right min-w-[4rem]">
      <%= format_money(product.price) %>
    </div>
  </div>

  <div class="flex items-center gap-1 shrink-0">
    <%= ui_row_edit_button(edit_product_path(product)) %>

    <% if current_user.admin? %>
      <%= ui_row_delete_button(product, confirm: "Sei sicuro di voler archiviare #{product.name}?") %>
    <% end %>
  </div>

</li>

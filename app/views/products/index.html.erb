<%= turbo_stream_from "products" %>
<%= render "shared/page_header", title: "Prodotti", counter: "#{Product.kept.count} totali", new_path: new_product_path %>

<%= render "shared/filter/form", url: products_path, frame: "products_list", placeholder: "Cerca prodotto..." %>

<%= render layout: "shared/list", locals: { frame: "products_list", records: @products, icon_name: "product", empty: "Nessun prodotto trovato" } do %>
  <ul id="products" class="list panel">
    <%= render partial: "product_row", collection: @products, as: :product %>
  </ul>
<% end %>

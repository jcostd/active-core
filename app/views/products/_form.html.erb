<%= form_with(model: product, class: "space-y-6") do |f| %>
  <%= render "shared/form_errors", model: product %>

  <%# --- SEZIONE 1: DETTAGLI PRODOTTO --- %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend font-bold text-base flex items-center gap-2">
      <%= icon("product", classes: "size-4") %> Dettagli Prodotto
    </legend>

    <%# Nome Prodotto %>
    <div>
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name,
             required: true,
             class: "input w-full text-lg font-medium",
             placeholder: "Es. Mensile Open, Carnet 10 Ingressi..." %>
    </div>

    <%# Griglia: Prezzo, Durata, Categoria %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full mt-2">
      <%# Prezzo %>
      <div>
        <%= f.label :price, class: "label" %>
        <label class="input w-full font-mono flex items-center gap-2">
          <span class="opacity-50">€</span>
          <%= f.text_field :price,
              class: "grow border-none focus:ring-0 p-0",
              placeholder: "0,00",
              inputmode: "decimal" %>
        </label>
      </div>

      <%# Durata %>
      <div>
        <%= f.label :duration_days, "Durata (Giorni)", class: "label" %>
        <%= f.number_field :duration_days, class: "input w-full", placeholder: "30" %>

        <p class="label-text-alt opacity-60 mt-1">
          30 = 1 Mese, 365 = 1 Anno
        </p>
      </div>

      <%# Categoria %>
      <div>
        <%= f.label :accounting_category, class: "label" %>
        <%= f.select :accounting_category,
            Product.accounting_categories.keys.map { |k| [k.titleize, k] },
         {},
         class: "select w-full" %>
      </div>
    </div>

    <%# --- INIZIO GESTIONE CARNET / PT --- %>
    <div data-controller="carnet-toggle" class="mt-6 p-4 bg-base-200/40 rounded-box border border-base-300">
      <label class="label cursor-pointer justify-start gap-4 w-fit">
        <input type="checkbox"
               class="toggle toggle-secondary"
               data-action="change->carnet-toggle#toggle"
               <%= 'checked' if product.entry_limit.present? %>>
        <span class="font-bold text-sm flex items-center gap-2">
          <%= icon("confirmation_number", classes: "size-4") %>
          È un Carnet a ingressi? (Es. Pacchetto 10 PT)
        </span>
      </label>

      <div data-carnet-toggle-target="content" class="mt-4 pl-14 <%= 'hidden' unless product.entry_limit.present? %>">
        <%= f.label :entry_limit, "Numero Totale Ingressi", class: "label text-xs font-bold uppercase opacity-70" %>
        <%= f.number_field :entry_limit,
        class: "input input-bordered w-full md:w-1/3",
          placeholder: "Es. 10",
              min: 1,
              data: { carnet_toggle_target: "input" } %>
        <div class="text-xs opacity-60 mt-2">
          Se impostato, l'abbonamento scalerà un ingresso ad ogni check-in e si bloccherà a quota zero.
        </div>
      </div>
    </div>
    <%# --- FINE GESTIONE CARNET / PT --- %>
  </fieldset>

  <%# --- SEZIONE 2: ACCESSI E DISCIPLINE --- %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend font-bold text-base flex items-center gap-2">
      <%= icon("fitness_center", classes: "size-4") %> Discipline Incluse
    </legend>

    <p class="text-sm text-base-content/70 mb-4">
      Seleziona a quali discipline e tornelli darà accesso questo abbonamento.
    </p>

    <% if Discipline.kept.any? %>
      <%# STRATAGEMMA UI/UX: Checkbox nascoste con stile a "Pill" interattiva %>
      <div class="flex flex-wrap gap-2">
        <%= f.collection_check_boxes :discipline_ids, Discipline.kept.order(:name), :id, :name do |b| %>
          <label class="cursor-pointer select-none">
            <%# Nascondiamo la checkbox vera e propria e usiamo 'peer' %>
            <%= b.check_box class: "peer hidden" %>

            <%# Questo div reagisce allo stato :checked del 'peer' nascosto %>
            <div class="px-4 py-2 rounded-full border border-base-300 bg-base-100 text-sm font-medium transition-all hover:border-primary/40 peer-checked:bg-primary peer-checked:text-primary-content peer-checked:border-primary shadow-sm">
              <%= b.text %>
            </div>
          </label>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-warning text-sm shadow-sm">
        <%= icon("warning", classes: "size-5") %>
        <div>
          <h3 class="font-bold">Nessuna disciplina trovata</h3>
          <div class="text-xs mt-1">
            Devi creare almeno una disciplina prima di associarla.
            <%= link_to "Creane una ora", new_discipline_path, class: "underline font-medium" %>
          </div>
        </div>
      </div>
    <% end %>
  </fieldset>

  <div class="modal-action">
    <%= f.submit "Salva",
             class: "btn btn-primary px-6",
             data: { turbo_submits_with: 'Salvataggio...' } %>
  </div>
<% end %>

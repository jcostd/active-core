<%= form_with model: product, class: "flex flex-col gap-4" do |f| %>
  <%= render "shared/form_errors", model: product %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("product", classes: "size-4") %> Prodotto</legend>

    <%= f.label :name %>
    <%= f.text_field :name, required: true, placeholder: "Es. Mensile Open, Trimestrale Yoga..." %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-4">
      <div>
        <%= f.label :price %>
        <label class="input w-full font-mono">
          <span class="opacity-50">€</span>
          <%= f.text_field :price, class: "grow", placeholder: "0,00", inputmode: "decimal" %>
        </label>
      </div>
      <div>
        <%= f.label :duration_days, "Durata (giorni)" %>
        <%= f.number_field :duration_days, placeholder: "30", disabled: product.terms_locked? %>
        <p class="label">30 = un mese, 365 = un anno</p>
      </div>
      <div>
        <%= f.label :accounting_category %>
        <%= f.select :accounting_category, [ [ "Quota Istituzionale (corsi)", "institutional" ], [ "Quota Associativa", "associative" ] ],
                     {}, disabled: product.terms_locked? %>
      </div>
    </div>

    <% if product.terms_locked? %>
      <p class="label whitespace-normal">Categoria e durata sono bloccate: il prodotto ha già abbonamenti venduti. Il prezzo vale per le prossime vendite.</p>
    <% end %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("fitness_center", classes: "size-4") %> Chi lo compra è iscritto a</legend>

    <% if Discipline.kept.any? %>
      <%# checkbox con stile btn di daisyUI: pillola accessibile da tastiera, il testo arriva da aria-label %>
      <div class="flex flex-wrap gap-2">
        <%= f.collection_check_boxes :discipline_ids, Discipline.kept.order(:name), :id, :name do |b| %>
          <%= b.check_box class: "btn btn-sm btn-outline btn-primary rounded-full", aria: { label: b.text } %>
        <% end %>
      </div>
    <% else %>
      <p class="label whitespace-normal">
        Nessuna disciplina ancora: <%= link_to "creane una", new_discipline_path, class: "link" %> prima di collegarla.
      </p>
    <% end %>
  </fieldset>

  <div class="modal-action"><%= f.submit %></div>
<% end %>

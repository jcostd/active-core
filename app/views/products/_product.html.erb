<%# app/views/products/_product.html.erb %>
<%# locals: (product:) %>

<div id="<%= dom_id(product) %>" class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">

  <%# -- COLONNA SINISTRA: DETTAGLI -- %>
  <div class="space-y-6">
    <div class="card bg-base-100 shadow-sm border border-base-200">
      <div class="card-body p-4 text-sm">
        <h3 class="text-xs font-bold uppercase opacity-50 tracking-wider mb-3 flex items-center gap-2">
          <%= icon("info") %> Specifiche
        </h3>

        <ul class="space-y-4">
          <li class="flex gap-3 items-center">
            <div class="p-2 rounded-box bg-primary/10 text-primary shrink-0">
              <%= icon("euro_symbol", size: 20) %>
            </div>
            <div class="leading-tight">
              <div class="text-[10px] opacity-50 uppercase font-bold tracking-wider">Prezzo</div>
              <div class="font-bold text-primary text-lg"><%= format_money(product.price) %></div>
            </div>
          </li>

          <li class="flex gap-3 items-center">
            <div class="p-2 rounded-box bg-secondary/10 text-secondary shrink-0">
              <%= icon("clock", size: 20) %>
            </div>
            <div class="leading-tight">
              <div class="text-[10px] opacity-50 uppercase font-bold tracking-wider">Validità</div>
              <div class="font-bold"><%= display_value(product.duration_days) %> <span class="text-xs opacity-70">giorni solari</span></div>
            </div>
          </li>

          <li class="flex gap-3 items-center">
            <div class="p-2 rounded-box bg-base-200 shrink-0 opacity-70">
              <%= icon("receipt", size: 20) %>
            </div>
            <div class="leading-tight">
              <div class="text-[10px] opacity-50 uppercase font-bold tracking-wider">Contabilità</div>
              <div class="font-bold">
                <%= product_category_text(product) %>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <%# -- COLONNA DESTRA: DISCIPLINE (2/3 width) -- %>
  <div class="lg:col-span-2 space-y-6">
    <div class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
      <div class="p-4 bg-base-200/30 border-b border-base-200 flex justify-between items-center">
        <h3 class="font-bold text-sm uppercase opacity-70 tracking-wider flex items-center gap-2">
          <%= icon("fitness_center") %> Discipline Abilitate
        </h3>
      </div>

      <div class="p-4 bg-base-100/50 border-b border-base-200 text-sm opacity-70">
        L'acquisto di questo prodotto sblocca l'accesso ai tornelli per le seguenti attività:
      </div>

      <% if product.disciplines.any? %>
        <ul class="list bg-base-100 rounded-none w-full">
          <% product.disciplines.each do |discipline| %>
            <li class="list-row items-center">
              <div>
                <div class="p-2 rounded-box bg-success/10 text-success">
                  <%= icon("check", size: 20) %>
                </div>
              </div>
              <div class="grow min-w-0">
                <div class="font-bold text-base"><%= display_value(discipline.name) %></div>
              </div>
              <div class="shrink-0 flex items-center gap-2 flex-wrap justify-end">
                <% if discipline.requires_medical_certificate? %>
                  <div class="badge badge-sm badge-ghost text-error gap-1 border-error/20 bg-error/5" title="Richiede Certificato Medico">
                    <%= icon("med", size: 14) %> <span class="hidden sm:inline">Cert. Medico</span>
                  </div>
                <% end %>

                <% if discipline.requires_membership? %>
                  <div class="badge badge-sm badge-ghost text-info gap-1 border-info/20 bg-info/5" title="Richiede Tesseramento">
                    <%= icon("card_membership", size: 14) %> <span class="hidden sm:inline">Tesseramento</span>
                  </div>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="p-8 text-center">
          <div class="bg-warning/10 text-warning w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3">
            <%= icon("warning") %>
          </div>
          <h4 class="font-bold">Nessuna disciplina collegata!</h4>
          <p class="text-sm opacity-60 mt-1 max-w-sm mx-auto">
            Questo prodotto non permette nessun accesso fisico ai varchi. È utile solo come servizio extra o prodotto da banco.
          </p>
        </div>
      <% end %>
    </div>
  </div>

</div>

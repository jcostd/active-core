<%# locals: (product:) %>
<div id="<%= dom_id(product) %>" class="record-layout">
  <%= render layout: "shared/panel", locals: { title: "Specifiche", icon_name: "info" } do %>
    <%= render "shared/details", rows: { "Prezzo" => format_money(product.price), "Validità" => ("#{product.duration_days} giorni" if product.duration_days),
                                          "Contabilità" => product_category_badge(product) } %>
  <% end %>

  <div class="record-main">
    <%= render layout: "shared/panel", locals: { title: "Chi lo compra è iscritto a", icon_name: "fitness_center" } do %>
      <% if product.disciplines.any? %>
        <ul class="list">
          <% product.disciplines.each do |discipline| %>
            <li class="list-row items-center">
              <%= icon("check", classes: "size-5 text-success") %>
              <%= link_to discipline.name, discipline, class: "list-col-grow font-bold link link-hover" %>
              <div class="flex gap-2">
                <%= ui_requirement_badge(discipline.requires_medical_certificate?, text: "Cert. Medico", icon_name: "med", active_class: "badge-error badge-soft") %>
                <%= ui_requirement_badge(discipline.requires_membership?, text: "Iscrizione", icon_name: "card_membership") %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", compact: true, icon_name: "warning", title: "Nessuna disciplina collegata",
                   message: "Chi lo compra non risulta iscritto a nessun corso: va bene per servizi extra o prodotti da banco." %>
      <% end %>
    <% end %>
  </div>
</div>

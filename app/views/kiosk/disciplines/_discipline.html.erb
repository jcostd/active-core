<% cache discipline do %>
  <%= link_to kiosk_discipline_path(discipline),
	      class: "card bg-base-100 border-2 border-base-300 active:border-primary active:bg-primary/5 active:scale-95 transition-all duration-200 ease-out shadow-sm touch-manipulation rounded-box group" do %>

    <div class="card-body items-center justify-center p-10 md:p-14 gap-5 md:gap-6">

      <%= icon("group", classes: "size-16 md:size-20 text-base-content/20 group-active:text-primary transition-colors duration-200") %>

      <h3 class="text-2xl md:text-3xl font-black uppercase tracking-widest text-base-content group-active:text-primary transition-colors duration-200 text-center leading-none">
        <%= discipline.name %>
      </h3>

    </div>

  <% end %>
<% end %>

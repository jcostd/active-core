<%= turbo_stream_from "attendances" %>
<%= turbo_stream_from "members" %>

<div class="flex items-center gap-4">
  <%= link_to kiosk_root_path, class: "btn btn-circle btn-ghost", title: "Discipline" do %>
    <%= icon("arrow_left", classes: "size-6") %>
  <% end %>
  <div>
    <h2 class="text-3xl font-black uppercase"><%= @discipline.name %></h2>
    <p class="text-sm font-bold opacity-50 uppercase tracking-wider">Registro di <%= l(@month, format: "%B %Y") %></p>
  </div>
</div>

<div class="relative" data-controller="autocomplete" data-action="click@window->autocomplete#clickOutside">
  <label class="input input-xl w-full focus-within:outline-primary shadow-sm bg-base-100 border-base-200">
    <%= icon("search", classes: "size-6 opacity-50") %>
    <input type="text"
           name="members_search"
           class="grow font-bold placeholder:font-normal placeholder:opacity-50"
           placeholder="Cerca nome o cognome di chi non è in lista..."
           autocomplete="off"
           data-autocomplete-target="input"
           data-action="input->autocomplete#search keyup->autocomplete#clearIfEmpty"
           data-url="<%= kiosk_discipline_member_searches_path(@discipline) %>" />
  </label>

  <turbo-frame id="<%= dom_id(@discipline, :member_search_results) %>" data-autocomplete-target="frame"></turbo-frame>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 items-start">
  <section id="pending_members" class="flex flex-col gap-3">
    <div class="divider divider-start font-bold uppercase text-xs opacity-50 tracking-wider m-0">
      Da smarcare (<%= @pending_members.size %>)
    </div>

    <% if @pending_members.empty? %>
      <%= render "shared/empty_state", icon_name: "check", title: "Nessuno da proporre",
                 message: "Chi è venuto e non è in lista si trova con la ricerca." %>
    <% else %>
      <%= render partial: "kiosk/members/pending", collection: @pending_members, as: :member,
                 locals: { discipline: @discipline, standings: @standings },
                 cached: ->(member) { [ member, @discipline, @standings[member] ] } %>
    <% end %>
  </section>

  <section id="attendances" class="flex flex-col gap-3">
    <div class="divider divider-start font-bold uppercase text-xs opacity-50 tracking-wider m-0">
      Nel registro (<%= @attendances.size %>)
    </div>

    <% if @attendances.empty? %>
      <%= render "shared/empty_state", icon_name: "group", title: "Registro vuoto",
                 message: "Smarca chi vedi alla prima lezione del mese." %>
    <% else %>
      <%= render partial: "kiosk/attendances/attendance", collection: @attendances,
                 locals: { standings: @standings },
                 cached: ->(attendance) { [ attendance, attendance.member, @standings[attendance.member] ] } %>
    <% end %>
  </section>
</div>

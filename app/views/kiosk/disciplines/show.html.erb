<%# app/views/kiosk/disciplines/show.html.erb %>

<div class="flex items-center gap-4 mb-8">
  <%= link_to kiosk_root_path, class: "btn btn-circle btn-ghost bg-base-100 text-base-content/50", data: { turbo_action: "replace" } do %>
    <%= icon("arrow_back", classes: "size-6") %>
  <% end %>
  <h2 class="text-3xl font-black uppercase"><%= @discipline.name %></h2>
</div>

<%# LA RICERCA A TUTTA LARGHEZZA IN ALTO %>
<div class="w-full mb-8">
  <div class="card bg-base-100 shadow-sm border border-base-200">
    <div class="card-body p-4 flex flex-row items-center gap-4">

      <div class="flex-grow" data-controller="autocomplete" data-action="click@window->autocomplete#clickOutside">
	<input type="text"
	       name="<%=@discipline.id %>_member_search"
	       class="input input-lg w-full font-bold focus:border-primary focus:ring-1 focus:ring-primary bg-base-200"
	       placeholder="🔍 Cerca nome, cognome o CF di un socio non in lista..."
	       autocomplete="off"
	       data-autocomplete-target="input"
	       data-action="input->autocomplete#search keyup->autocomplete#clearIfEmpty"
	       data-url="<%= kiosk_discipline_member_searches_path(@discipline) %>">

	<turbo-frame id="<%=@discipline.id %>_member_search_results" data-autocomplete-target="frame"></turbo-frame>
      </div>

    </div>
  </div>
</div>

<%# LO SPLIT A DUE COLONNE %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

  <%# COLONNA SINISTRA: DA SMARCARE %>
  <div class="flex flex-col gap-4">
    <h3 class="font-bold uppercase tracking-wider text-sm opacity-50 sticky top-0 bg-base-200/90 backdrop-blur py-2 z-10">
      Da Smarcare (<%= @pending_members.size %>)
    </h3>

    <% if @pending_members.empty? %>
      <div class="p-8 text-center border-2 border-dashed border-base-200 rounded-xl opacity-50 font-bold">
        Nessun socio da smarcare.
      </div>
    <% else %>
      <% @pending_members.each do |member| %>
        <%= render "kiosk/members/card", member: member, discipline: @discipline %>
      <% end %>
    <% end %>
  </div>

  <%# COLONNA DESTRA: PRESENTI IN SALA %>
  <div class="flex flex-col gap-4">
    <h3 class="font-bold uppercase tracking-wider text-sm opacity-50 sticky top-0 bg-base-200/90 backdrop-blur py-2 z-10">
      Oggi in Sala (<%= @today_accesses.size %>)
    </h3>

    <% if @today_accesses.empty? %>
      <div class="p-8 text-center border-2 border-dashed border-base-200 rounded-xl opacity-50 font-bold">
        Nessuno ha ancora fatto check-in.
      </div>
    <% else %>
      <% @today_accesses.each do |log| %>
        <%# ATTENZIONE: Qui passiamo il LOG, non il member, per avere il design verde/rosso %>
        <%= render "kiosk/members/checked_in_card", log: log %>
      <% end %>
    <% end %>
  </div>

</div>

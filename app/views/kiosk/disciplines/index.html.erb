<div class="flex flex-col items-center flex-grow w-full max-w-5xl mx-auto mt-8 md:mt-12">

  <div class="text-center mb-10 md:mb-16">
    <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-3">Seleziona il Corso</h2>
    <p class="text-xl opacity-60 font-medium">Tocca la disciplina per aprire il registro del mese.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 w-full px-4">
    <%= render partial: "kiosk/disciplines/discipline", collection: @disciplines, cached: true %>
  </div>

  <div class="w-full px-4 mt-8 md:mt-12">
    <%= link_to kiosk_private_lessons_path,
                class: "card card-side items-center bg-base-100 border-2 border-dashed border-base-300 active:border-primary active:bg-primary/5 active:scale-95 transition-all duration-200 ease-out touch-manipulation rounded-box group" do %>
      <div class="pl-8 md:pl-10 text-base-content/30 group-active:text-primary"><%= icon("event", classes: "size-12") %></div>
      <div class="card-body py-8">
        <h3 class="text-2xl font-black uppercase tracking-widest group-active:text-primary">Lezioni private</h3>
        <p class="opacity-60 font-medium">Scrivi chi ha tenuto una privata e per chi.</p>
      </div>
    <% end %>
  </div>

</div>

<%# app/views/kiosk/member_searches/index.html.erb %>

<turbo-frame id="<%= dom_id(@discipline, :member_search_results) %>">
  <% if @members.any? %>
    <ul class="list bg-base-100 w-full shadow-2xl rounded-box border border-base-300 absolute z-50 mt-1 max-h-72 overflow-y-auto">

      <% @members.each do |member| %>
        <li class="p-0 border-b border-base-200 last:border-0">

          <%# IL VERO MODO RAILS: Un form POST nativo che dice a Turbo di aggiornare la pagina (_top) %>
          <%= button_to kiosk_discipline_access_logs_path(@discipline, member_id: member.id),
                        method: :post,
                        class: "w-full text-left flex flex-col justify-center gap-1.5 px-4 py-3 hover:bg-base-200/60 transition-colors cursor-pointer",
                        data: { turbo_frame: "_top" } do %>

            <div class="font-bold text-base leading-none text-base-content truncate w-full flex items-center justify-between">
              <%= member.full_name %>

              <% unless member.medical_certificate_valid? %>
                <span class="text-[10px] font-bold text-error uppercase flex items-center gap-1"><%= icon("warning", classes: "size-3 inline") %> Cert. Scad.</span>
              <% end %>
            </div>

            <div class="flex flex-wrap items-center gap-1 text-xs opacity-60 w-full truncate font-mono">
              CF: <%= display_value(member.fiscal_code, placeholder: "N/A") %>
              <span class="w-1 h-1 rounded-full bg-base-content/30 hidden sm:block"></span>
              BIRTH: <%= format_date(member.birth_date) %>
            </div>

          <% end %>
        </li>
      <% end %>

    </ul>
  <% else %>
    <div class="p-4 bg-base-100 shadow-2xl rounded-box border border-base-300 absolute z-50 mt-1 w-full text-sm opacity-60 italic text-center">
      Nessun socio trovato con questa ricerca.
    </div>
  <% end %>
</turbo-frame>

<%# locals: (member:, discipline:) %>
<% policy = AccessPolicy.new(member:, discipline:).evaluate! %>
<% style = kiosk_pending_style(policy) %>

  <div id="<%= dom_id(member, :pending) %>" class="card shadow-sm border transition-colors <%= style[:card] %>">
    <div class="card-body p-4 flex flex-row items-center justify-between gap-4">

      <div class="flex items-center gap-4">
        <%= ui_avatar(member, size: "size-12", text_size: "text-md") %>
        <div>
          <h4 class="font-bold text-lg leading-tight truncate max-w-[180px]"><%= member.full_name %></h4>

          <div class="flex flex-col gap-0.5 mt-1">
            <% if (note = kiosk_policy_note(policy)) %>
              <span class="text-[10px] uppercase font-bold"><%= note %></span>
            <% end %>
          </div>
        </div>
      </div>

      <%= button_to kiosk_discipline_access_logs_path(discipline),
                    params: { member_id: member.id },
                    class: "btn btn-circle btn-lg shadow-md #{style[:button]}",
                    data: { turbo: true } do %>
        <%= icon("check", classes: "size-8") %>
      <% end %>

    </div>
  </div>

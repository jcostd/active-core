<%= form_with model: feedback do |f| %>
  <%= render "shared/form_errors", model: feedback %>
  <%= f.hidden_field :page_url %>

  <fieldset class="fieldset">
    <%= f.label :message, "Come possiamo aiutarti?" %>
    <%= f.text_area :message, rows: 5, required: true, autofocus: true, placeholder: "Ho trovato un errore in... / Vorrei che ci fosse..." %>
  </fieldset>

  <div class="modal-action"><%= f.submit "Invia" %></div>
<% end %>

<%# locals: (user:) %>
<%= render layout: "shared/row", locals: { record: user, title: user.full_name, figure: ui_avatar(user, size: "size-10", text_size: "text-md"),
                                           aside: user_role_badge(user, size: "badge-xs"), edit_path: edit_user_path(user),
                                           archive_confirm: ("Archiviare #{user.full_name}?" if user.archivable_by?(current_user)) } do %>
  <span class="text-xs font-mono opacity-60">@<%= user.username %></span>
<% end %>

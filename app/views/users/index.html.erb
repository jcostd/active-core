<%= turbo_stream_from "users" %>
<%= render "shared/page_header", title: "Utenti di Sistema", counter: "#{User.kept.count} totali", new_path: new_user_path %>

<%= render layout: "shared/filter/form", locals: { url: users_path, frame: "users_list", placeholder: "Cerca nome o username...", drawer_title: "Filtri Utenti" } do %>
  <%= filter_select :role, [ [ "Staff", "staff" ], [ "Amministratore", "admin" ], [ "Kiosk", "kiosk" ] ], label: "Ruolo", blank: "Tutti i ruoli" %>
<% end %>

<%= render layout: "shared/list", locals: { frame: "users_list", records: @users, filter_keys: %i[role], empty: "Nessun utente trovato" } do %>
  <ul id="users" class="list panel">
    <%= render partial: "users/row", collection: @users, as: :user, cached: ->(user) { [ user, user == current_user ] } %>
  </ul>
<% end %>

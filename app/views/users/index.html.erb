<%= turbo_stream_from "users" %>

<% content_for :page_title, "Utenti di Sistema" %>

<% content_for :page_counter, "#{@total_active_users} totali" %>

<% content_for :page_actions do %>
  <%= link_to [:new, :user],
              class: "btn btn-primary gap-2",
              data: { turbo_frame: "modal" } do %>
    <%= icon("add") %>
    <span class="hidden sm:inline">Nuovo</span>
  <% end %>
<% end %>

<% content_for :page_search_and_filters do %>
  <%= render layout: "shared/filter/form",
             locals: { url: users_path, frame: "users_list", placeholder: "Cerca nome, email...", drawer_title: "Filtri Utenti" } do |form| %>
    <%= filter_select form, :role, [ [ "Staff", "staff" ], [ "Amministratore", "admin" ], [ "Kiosk", "kiosk" ] ], label: "Ruolo", blank: "Tutti i ruoli" %>
  <% end %>
<% end %>

<%= render "shared/header/page" %>

<%= turbo_frame_tag "users_list" do %>
  <%= render "shared/filter/active", filter_keys: [:role] %>

  <div class="mt-6">
    <% if @users.empty? %>
      <%= render "shared/empty_state",
		 icon_name: "filter_off",
		 title: "Nessun utente trovato",
		 message: "Prova a cambiare i criteri di ricerca o rimuovere i filtri." %>
    <% else %>

      <%= filtered_results_counter(@pagy) %>

      <ul id="users" class="list bg-base-100 rounded-box shadow-sm">
	<%= render partial: "users/row", collection: @users, as: :user,
                 cached: ->(user) { [ user, user == current_user ] } %>
      </ul>

      <%= render "shared/pagination" %>
    <% end %>
  </div>
<% end %>

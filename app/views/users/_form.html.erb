<%= form_with model: user, class: "flex flex-col gap-4" do |f| %>
  <%= render "shared/form_errors", model: user %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("badge", classes: "size-4") %> Identità</legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
      <div>
        <%= f.label :first_name %>
        <%= f.text_field :first_name, required: true, placeholder: "Mario" %>
      </div>
      <div>
        <%= f.label :last_name %>
        <%= f.text_field :last_name, required: true, placeholder: "Rossi" %>
      </div>
    </div>

    <%= f.label :username %>
    <%= f.text_field :username, required: true, placeholder: "mario_rossi" %>
    <p class="label">Serve per entrare. Solo lettere minuscole, numeri e underscore.</p>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= icon("fingerprint", classes: "size-4") %> Accesso</legend>

    <%= f.label :role %>
    <% if user.kiosk? %>
      <p class="label whitespace-normal">Utente fisso dell'iPad: usa solo il kiosk, non si archivia e non cambia ruolo.</p>
    <% else %>
      <%= f.select :role, user_role_options, {}, disabled: !current_user.admin? %>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
      <div>
        <%= f.label :password, "Nuova password" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>
      <div>
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>
    </div>
    <% if user.persisted? %>
      <p class="label">Vuota per tenere quella attuale.</p>
    <% end %>
  </fieldset>

  <div class="modal-action"><%= f.submit %></div>
<% end %>
